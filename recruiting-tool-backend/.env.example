# App configuration

PORT = 4000 # Default value: 4000
DATABASE_URL="postgresql://postgres:password@localhost:5432/recruiting_tool_db"
JWT_SECRET = 'YOURSECRETTOKEN'

# Super Admin credentials
ADMIN_NAME = 'John Doe'
ADMIN_PASSWORD = 'Testing123'
ADMIN_EMAIL = 'johndoe@hotmail.com'

# Frontend URL for CORS
FRONTEND_URL = 'http://localhost:3000'

# Email/SMTP Configuration
SMTP_ENABLED = 'false' # Set to 'true' to enable email sending
SMTP_HOST = 'smtp.gmail.com' # Example: smtp.gmail.com, smtp.sendgrid.net
SMTP_PORT = 587 # Common ports: 587 (TLS), 465 (SSL), 25 (non-secure)
SMTP_USER = 'your-email@example.com'
SMTP_PASSWORD = 'your-email-password-or-app-password'
EMAIL_FROM = 'noreply@recruiting.com' # From address for sent emails

# OpenAI Configuration
OPENAI_API_KEY = 'sk-your-openai-api-key-here'
OPENAI_MODEL = 'gpt-4-turbo-preview' # Options: gpt-4-turbo-preview, gpt-3.5-turbo, gpt-4

# Google Calendar Integration
GOOGLE_CLIENT_ID = 'your-google-client-id.apps.googleusercontent.com'
GOOGLE_CLIENT_SECRET = 'your-google-client-secret'
GOOGLE_REDIRECT_URI = 'http://localhost:4000/google-calendar/callback'

# Webhook API Key for n8n Integration
WEBHOOK_API_KEY = 'your-secure-webhook-api-key-change-in-production'

# Backup Configuration
BACKUP_ENABLED = 'true' # Set to 'true' to enable automatic backups
BACKUP_CRON = '0 2 * * *' # Cron schedule (default: 2 AM daily)
BACKUP_RETENTION_DAYS = '30' # Number of days to keep backups
BACKUP_PATH = '/backups' # Path where backups will be stored
MINIO_DATA_PATH = '/data/minio' # Path to MinIO data directory for file backups

# Rate Limiting Configuration
# Global default limits (applies to all endpoints unless overridden)
THROTTLE_TTL = '900000' # Time window in milliseconds (default: 15 minutes)
THROTTLE_LIMIT = '100' # Max requests per time window (default: 100)

# Authentication endpoints
THROTTLE_AUTH_TTL = '900000' # 15 minutes in ms
THROTTLE_AUTH_LIMIT = '5' # Max login attempts per IP

# Registration endpoint
THROTTLE_REGISTER_TTL = '3600000' # 1 hour in ms
THROTTLE_REGISTER_LIMIT = '3' # Max registrations per IP

# AI endpoints (parse-resume, score-candidate)
THROTTLE_AI_TTL = '3600000' # 1 hour in ms
THROTTLE_AI_LIMIT = '10' # Max AI requests per IP

# Public application submissions
THROTTLE_APPLICATION_TTL = '3600000' # 1 hour in ms
THROTTLE_APPLICATION_LIMIT = '5' # Max applications per IP