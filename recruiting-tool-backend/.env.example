# App configuration

NODE_ENV = 'development' # Options: development, production
DUMMY_DATA_ENABLED = 'true' # Set to 'false' in production to disable dummy data seeding
PORT = 4000 # Default value: 4000
DATABASE_URL="postgresql://postgres:password@localhost:5432/recruiting_tool_db"
JWT_SECRET = 'YOURSECRETTOKEN'

# Database Connection Pooling Configuration
# Connection pool size (min/max connections)
DATABASE_POOL_MIN = '2' # Minimum connections to maintain (default: 2)
DATABASE_POOL_MAX = '10' # Maximum connections allowed (development: 10, production: 20)
# Connection timeout in milliseconds (time to wait for available connection)
DATABASE_POOL_ACQUIRE_TIMEOUT = '60000' # 60 seconds
# Idle timeout in milliseconds (time before idle connection is closed)
DATABASE_POOL_IDLE_TIMEOUT = '600000' # 10 minutes
# Connection max lifetime in milliseconds (time before connection is recycled)
DATABASE_POOL_MAX_LIFETIME = '1800000' # 30 minutes
# Enable connection pool logging
DATABASE_POOL_LOGGING = 'false' # Set to 'true' to enable detailed pool logging

# Super Admin credentials
ADMIN_NAME = 'John Doe'
ADMIN_PASSWORD = 'Testing123'
ADMIN_EMAIL = 'johndoe@hotmail.com'

# Frontend URL for CORS
FRONTEND_URL = 'http://localhost:3000'

# Email/SMTP Configuration
SMTP_ENABLED = 'false' # Set to 'true' to enable email sending
SMTP_HOST = 'smtp.gmail.com' # Example: smtp.gmail.com, smtp.sendgrid.net
SMTP_PORT = 587 # Common ports: 587 (TLS), 465 (SSL), 25 (non-secure)
SMTP_USER = 'your-email@example.com'
SMTP_PASSWORD = 'your-email-password-or-app-password'
EMAIL_FROM = 'noreply@recruiting.com' # From address for sent emails

# Google Calendar Integration (OAuth 2.0)
# Get credentials from: https://console.cloud.google.com/apis/credentials
# Required scopes: calendar.events, calendar.readonly
GOOGLE_CLIENT_ID = 'your-google-client-id.apps.googleusercontent.com'
GOOGLE_CLIENT_SECRET = 'your-google-client-secret'
GOOGLE_REDIRECT_URI = 'http://localhost:4000/calendar/auth/google/callback' # Must match Google Console

# Auth0 Configuration (Social Login - Optional)
# Get credentials from: https://manage.auth0.com/
# Create an API in Auth0 Dashboard and note the audience and domain
# Leave empty to disable Auth0 social login (app works without it)
AUTH0_DOMAIN = 'your-tenant.auth0.com' # Your Auth0 domain (e.g., dev-abc123.us.auth0.com)
AUTH0_AUDIENCE = 'https://your-api-audience' # API identifier from Auth0 dashboard
AUTH0_CLIENT_ID = 'your-auth0-client-id' # Application Client ID from Auth0

# Webhook API Key for n8n Integration
WEBHOOK_API_KEY = 'your-secure-webhook-api-key-change-in-production'

# Internal API Key for Claude / automated tools
# Used to protect internal endpoints (e.g. POST /api/internal/batch-summary)
INTERNAL_API_KEY = 'changeme'

# Stripe Configuration
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY = 'sk_test_your-stripe-secret-key-here' # Use sk_live_ for production
STRIPE_WEBHOOK_SECRET = 'whsec_your-webhook-signing-secret' # For webhook signature verification
# Create price IDs in Stripe Dashboard: https://dashboard.stripe.com/prices
# Professional Plan: $79/month or $708/year ($59/mo)
STRIPE_PROFESSIONAL_PRICE_ID = 'price_professional_monthly_id'
# Enterprise Plan: $299/month or $2988/year ($249/mo)
STRIPE_ENTERPRISE_PRICE_ID = 'price_enterprise_monthly_id'

# Backup Configuration
BACKUP_ENABLED = 'true' # Set to 'true' to enable automatic backups
BACKUP_CRON = '0 2 * * *' # Cron schedule (default: 2 AM daily)
BACKUP_RETENTION_DAYS = '30' # Number of days to keep backups
BACKUP_PATH = '/backups' # Path where backups will be stored
MINIO_DATA_PATH = '/data/minio' # Path to MinIO data directory for file backups

# Rate Limiting Configuration
# Global default limits (applies to all endpoints unless overridden)
# Note: Increase to 500 for development/QA testing to avoid blocking normal usage
# Keep at 100 for production to maintain security
THROTTLE_TTL = '900000' # Time window in milliseconds (default: 15 minutes)
THROTTLE_LIMIT = '500' # Max requests per time window (default: 100, development: 500)

# Authentication endpoints
THROTTLE_AUTH_TTL = '900000' # 15 minutes in ms
THROTTLE_AUTH_LIMIT = '5' # Max login attempts per IP

# Registration endpoint
THROTTLE_REGISTER_TTL = '3600000' # 1 hour in ms
THROTTLE_REGISTER_LIMIT = '3' # Max registrations per IP

# AI endpoints (parse-resume, score-candidate)
THROTTLE_AI_TTL = '3600000' # 1 hour in ms
THROTTLE_AI_LIMIT = '10' # Max AI requests per IP

# Public application submissions
THROTTLE_APPLICATION_TTL = '3600000' # 1 hour in ms
THROTTLE_APPLICATION_LIMIT = '5' # Max applications per IP

# Google Gemini AI Configuration
# Get API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY = 'your-gemini-api-key-here' # Required for AI features (resume parsing, candidate scoring)
GEMINI_MODEL = 'gemini-1.5-flash' # Model to use (default: gemini-1.5-flash, alternative: gemini-1.5-pro)
GEMINI_TIER = 'free' # API tier: 'free' (15 RPM) or 'paid' (360 RPM)