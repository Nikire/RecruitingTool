generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

// Database connection with connection pooling
// Connection pool is configured via DATABASE_URL query parameters or PrismaClient options
// See: https://www.prisma.io/docs/concepts/components/prisma-client/working-with-prismaclient/connection-management
//
// Recommended DATABASE_URL format with connection pooling:
// postgresql://user:password@host:5432/dbname?connection_limit=10&pool_timeout=60&connect_timeout=10
//
// Connection pool configuration (via environment variables):
// - DATABASE_POOL_MIN: Minimum connections to maintain (default: 2)
// - DATABASE_POOL_MAX: Maximum connections allowed (dev: 10, prod: 20)
// - DATABASE_POOL_ACQUIRE_TIMEOUT: Time to wait for available connection (default: 60s)
// - DATABASE_POOL_IDLE_TIMEOUT: Time before idle connection is closed (default: 10min)
// - DATABASE_POOL_MAX_LIFETIME: Time before connection is recycled (default: 30min)
//
// PostgreSQL connection limits:
// - PostgreSQL default max_connections: 100
// - Docker container default: 100
// - Reserve ~30% for other connections (pgAdmin, migrations, etc.)
// - Development pool max: 10 connections
// - Production pool max: 20 connections
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                 Int                 @id @default(autoincrement())
  uid                String              @unique @default(uuid()) @db.Uuid
  name               String
  description        String?
  logoUrl            String?
  website            String?
  industry           String?
  companySize        String?
  foundedYear        Int?
  location           String?
  linkedinUrl        String?
  twitterUrl         String?
  instagramUrl       String?
  careersEnabled     Boolean             @default(true)
  careersHeadline    String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  users              User[]
  jobPositions       JobPosition[]
  hiringProcesses    HiringProcess[]
  emailTemplates     EmailTemplate[]
  scorecardTemplates ScorecardTemplate[]
  aiQuotas           AIQuota[]
  aiUsageLogs        AIUsageLog[]
  subscription       Subscription?
  connectionRequests ConnectionRequest[]
  invitations        CompanyInvitation[] @relation("CompanyInvitations")
  feedback           Feedback[]          @relation("CompanyFeedback")

  @@index([uid])
  @@index([name])
  @@index([createdAt])
}

model User {
  id                         Int                    @id @default(autoincrement())
  uid                        String                 @unique @default(uuid()) @db.Uuid
  name                       String
  email                      String
  password                   String?
  auth0Id                    String?                @unique
  provider                   String?                @default("local")
  roles                      RolesType[]            @default([USER])
  profilePicture             String?
  phoneNumber                String?
  position                   String?
  department                 String?
  bio                        String?
  linkedinUrl                String?
  portfolioUrl               String?
  location                   String?
  timezone                   String?
  googleRefreshToken         String?
  resumeUrl                  String?
  resumeFileName             String?
  onboardingCompleted        Boolean                @default(false)
  emailVerified              Boolean                @default(false)
  emailVerificationToken     String?                @unique
  emailVerificationSentAt    DateTime?
  isActive                   Boolean                @default(true)
  deactivatedAt              DateTime?
  deactivatedBy              Int?
  lastLoginAt                DateTime?
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  companyId                  Int?
  company                    Company?               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  profile                    Profile?
  jobPositions               JobPosition[]          @relation("JobPositionsUser")
  fileUploads                FileUpload[]           @relation("FileUploadsUser")
  reviewedApplications       Application[]          @relation("ApplicationReviewer")
  candidateNotes             CandidateNote[]        @relation("CandidateNoteAuthor")
  emailTemplates             EmailTemplate[]        @relation("EmailTemplateCreatedBy")
  scheduledInterviews        Interview[]            @relation("InterviewScheduledBy")
  interviewParticipations    InterviewInterviewer[] @relation("InterviewParticipations")
  interviewReschedules       InterviewReschedule[]  @relation("InterviewReschedules")
  stageNotes                 StageNote[]            @relation("StageNoteAuthor")
  activityLogs               UserActivityLog[]      @relation("UserActivityLogs")
  schedules                  HRSchedule[]           @relation("UserSchedules")
  scorecardEvaluations       Scorecard[]            @relation("ScorecardEvaluations")
  aiUsageLogs                AIUsageLog[]           @relation("UserAIUsageLogs")
  candidateActivities        CandidateActivity[]    @relation("CandidateActivityUser")
  refreshTokens              RefreshToken[]         @relation("UserRefreshTokens")
  passwordResetTokens        PasswordResetToken[]   @relation("UserPasswordResetTokens")
  auditLogs                  AuditLog[]             @relation("UserAuditLogs")
  calendarConnections        CalendarConnection[]   @relation("UserCalendarConnections")
  notifications              Notification[]             @relation("UserNotifications")
  notificationPreferences    NotificationPreference?    @relation("UserNotificationPreferences")
  connectionRequests         ConnectionRequest[]        @relation("UserConnectionRequests")
  reviewedConnectionRequests ConnectionRequest[]        @relation("ReviewedConnectionRequests")
  sentInvitations            CompanyInvitation[]        @relation("UserInvitations")
  feedback                   Feedback[]                 @relation("UserFeedback")

  @@unique([email, companyId])
  @@index([email])
  @@index([companyId])
  @@index([isActive])
  @@index([roles])
  @@index([uid])
  @@index([companyId, isActive])
  @@index([createdAt])
  @@index([lastLoginAt])
  @@index([auth0Id])
  @@index([provider])
  @@map("User")
}

model Notification {
  id        Int              @id @default(autoincrement())
  uid       String           @unique @default(uuid()) @db.Uuid
  userId    Int
  user      User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String           @db.Text
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())
  readAt    DateTime?

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([uid])
  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("Notification")
}

model NotificationPreference {
  id        Int      @id @default(autoincrement())
  uid       String   @unique @default(uuid()) @db.Uuid
  userId    Int      @unique
  user      User     @relation("UserNotificationPreferences", fields: [userId], references: [id], onDelete: Cascade)

  // Email preferences
  emailApplicationStatus    Boolean @default(true)
  emailInterviewScheduled   Boolean @default(true)
  emailNewCandidate         Boolean @default(true)
  emailSystemAnnouncement   Boolean @default(true)

  // In-app preferences
  inAppApplicationStatus    Boolean @default(true)
  inAppInterviewScheduled   Boolean @default(true)
  inAppNewCandidate         Boolean @default(true)
  inAppSystemAnnouncement   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([uid])
  @@map("NotificationPreference")
}

model Candidate {
  id              Int                 @id @default(autoincrement())
  uid             String              @unique @default(uuid()) @db.Uuid
  name            String
  email           String              @unique
  source          ApplicationSource?  @default(DIRECT_APPLY)
  sourceDetails   String?
  sourceUrl       String?
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  deletedAt       DateTime?
  hiringProcesses HiringProcess[]     @relation("HiringProcessCandidate")
  files           FileUpload[]        @relation("CandidateFiles")
  notes           CandidateNote[]     @relation("CandidateNotes")
  stageTimeLogs   StageTimeLog[]      @relation("CandidateStageTimeLogs")
  scores          CandidateScore[]    @relation("CandidateScores")
  activities      CandidateActivity[] @relation("CandidateActivities")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([email])
  @@index([source])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([uid])
  @@map("Candidate")
}

model CandidateNote {
  id          Int       @id @default(autoincrement())
  uid         String    @unique @default(uuid()) @db.Uuid
  content     String    @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  candidateId Int
  candidate   Candidate @relation("CandidateNotes", fields: [candidateId], references: [id], onDelete: Cascade)
  authorId    Int?
  author      User?     @relation("CandidateNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([candidateId])
  @@index([authorId])
  @@index([uid])
  @@index([createdAt])
}

enum RolesType {
  USER
  ADMIN
  SUPER_ADMIN
  HR
  HR_MANAGER
  RECRUITER
  COMPANY_OWNER
  COMPANY_ADMIN
}

enum ApplicationSource {
  WEBSITE
  LINKEDIN
  INDEED
  GLASSDOOR
  REFERRAL
  JOB_FAIR
  UNIVERSITY
  RECRUITER
  DIRECT_APPLY
  SOCIAL_MEDIA
  MANUAL
  CSV_IMPORT
  OTHER
}

model JobPosition {
  id                  Int               @id @default(autoincrement())
  uid                 String            @unique @default(uuid()) @db.Uuid
  title               String
  description         String?
  customQuestions     Json?             @default("[]")
  jobCategory         String?
  jobType             JobType?
  workLocation        WorkLocation?
  salaryMin           Int?
  salaryMax           Int?
  salaryCurrency      String            @default("USD")
  salaryPeriod        SalaryPeriod?
  benefits            String[]          @default([])
  requirements        String[]          @default([])
  responsibilities    String[]          @default([])
  experienceLevel     ExperienceLevel?
  educationLevel      String?
  skills              String[]          @default([])
  applicationDeadline DateTime?
  isUrgent            Boolean           @default(false)
  isFeatured          Boolean           @default(false)
  city                String?
  state               String?
  country             String?
  showSalary          Boolean           @default(false)
  tags                String[]          @default([])
  isHighlighted       Boolean           @default(false)
  viewCount           Int               @default(0)
  applicationCount    Int               @default(0)
  deletedAt           DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  createdById         Int
  createdBy           User              @relation("JobPositionsUser", fields: [createdById], references: [id], onDelete: Restrict)
  companyId           Int
  company             Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  stages              Stage[]
  status              JobPositionStatus @default(OPEN)
  hiringProcesses     HiringProcess[]
  applications        Application[]
  candidateScores     CandidateScore[]  @relation("JobPositionScores")
  batchScoringJobs    BatchScoringJob[] @relation("BatchScoringJobs")

  @@index([status])
  @@index([companyId])
  @@index([createdById])
  @@index([companyId, status])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([companyId, deletedAt])
  @@index([uid])
  @@index([title])
  @@index([jobCategory])
  @@index([jobType])
  @@index([workLocation])
  @@index([experienceLevel])
  @@index([isUrgent])
  @@index([isFeatured])
  @@index([applicationDeadline])
  @@index([city])
  @@index([country])
  @@index([isHighlighted])
  @@index([viewCount])
  @@index([applicationCount])
}

model HiringProcess {
  id             Int                 @id @default(autoincrement())
  uid            String              @unique @default(uuid()) @db.Uuid
  title          String
  status         HiringProcessStatus @default(OPEN)
  accessCode     String?             @unique
  codeExpiresAt  DateTime?
  lastAccessedAt DateTime?
  accessCount    Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  candidateId    Int?
  candidate      Candidate?          @relation("HiringProcessCandidate", fields: [candidateId], references: [id], onDelete: SetNull)
  stages         Stage[]
  stageNotes     StageNote[]         @relation("HiringProcessStageNotes")
  jobPosition    JobPosition         @relation(fields: [jobPositionId], references: [id], onDelete: SetNull)
  jobPositionId  Int
  companyId      Int
  company        Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([candidateId, jobPositionId])
  @@index([status])
  @@index([jobPositionId])
  @@index([candidateId])
  @@index([companyId])
  @@index([companyId, status])
  @@index([createdAt])
  @@index([uid])
  @@index([jobPositionId, status])
  @@index([candidateId, status])
  @@index([accessCode])
  @@index([codeExpiresAt])
}

enum HiringProcessStatus {
  OPEN
  CLOSED
  IN_PROGRESS
  CANCELLED
  REJECTED
}

enum JobPositionStatus {
  OPEN
  CLOSED
  CANCELLED
}

model Stage {
  id              Int            @id @default(autoincrement())
  uid             String         @unique @default(uuid()) @db.Uuid
  title           String
  type            StageType
  description     String
  status          StageStatus    @default(OPEN)
  deletedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  hiringProcess   HiringProcess? @relation(fields: [hiringProcessId], references: [id], onDelete: Cascade)
  hiringProcessId Int?
  position        Int
  JobPosition     JobPosition?   @relation(fields: [jobPositionId], references: [id], onDelete: SetNull)
  jobPositionId   Int?
  estimatedTime   Int?
  interviews      Interview[]    @relation("StageInterviews")
  notes           StageNote[]    @relation("StageNotes")
  timeLogs        StageTimeLog[] @relation("StageTimeLogs")

  @@unique([hiringProcessId, position])
  @@index([hiringProcessId])
  @@index([jobPositionId])
  @@index([status])
  @@index([position])
  @@index([hiringProcessId, position])
  @@index([deletedAt])
  @@index([uid])
  @@index([type])
  @@index([createdAt])
}

model StageNote {
  id              Int           @id @default(autoincrement())
  uid             String        @unique @default(uuid()) @db.Uuid
  content         String        @db.Text
  rating          Int
  stageId         Int
  stage           Stage         @relation("StageNotes", fields: [stageId], references: [id], onDelete: Cascade)
  hiringProcessId Int
  hiringProcess   HiringProcess @relation("HiringProcessStageNotes", fields: [hiringProcessId], references: [id], onDelete: Cascade)
  authorId        Int
  author          User          @relation("StageNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([stageId, hiringProcessId])
  @@index([stageId])
  @@index([hiringProcessId])
  @@index([authorId])
  @@index([uid])
  @@index([createdAt])
}

enum StageStatus {
  OPEN
  CURRENT
  CANCELLED
  DONE
}

enum StageType {
  INTERVIEW
  TECHNICAL_INTERVIEW
  FINAL_INTERVIEW
  OFFER
}

model FileUpload {
  id                 Int           @id @default(autoincrement())
  uid                String        @unique @default(uuid()) @db.Uuid
  filename           String
  originalName       String
  mimetype           String
  size               Int
  s3Key              String
  hash               String? // SHA-256 hash for deduplication (optional for backward compatibility)
  uploadedByPublic   Boolean       @default(false)
  uploadedById       Int?
  uploadedBy         User?         @relation("FileUploadsUser", fields: [uploadedById], references: [id], onDelete: Restrict)
  candidateId        Int?
  candidate          Candidate?    @relation("CandidateFiles", fields: [candidateId], references: [id], onDelete: Cascade)
  applicationResumes Application[] @relation("ApplicationResume")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([candidateId])
  @@index([uploadedById])
  @@index([uid])
  @@index([createdAt])
  @@index([uploadedByPublic])
  @@index([hash])
}

model Application {
  id             Int               @id @default(autoincrement())
  uid            String            @unique @default(uuid()) @db.Uuid
  jobPositionId  Int?
  jobPosition    JobPosition?      @relation(fields: [jobPositionId], references: [id], onDelete: SetNull)
  applicantName  String
  applicantEmail String
  applicantPhone String
  resumeFileId   Int?
  resumeFile     FileUpload?       @relation("ApplicationResume", fields: [resumeFileId], references: [id], onDelete: SetNull)
  coverLetter    String?           @db.Text
  customAnswers  Json?             @default("{}")
  status         ApplicationStatus @default(PENDING)
  deletedAt      DateTime?
  appliedAt      DateTime          @default(now())
  reviewedAt     DateTime?
  reviewedById   Int?
  reviewedBy     User?             @relation("ApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  notes          String?           @db.Text
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([jobPositionId, applicantEmail])
  @@index([status])
  @@index([jobPositionId])
  @@index([applicantEmail])
  @@index([reviewedById])
  @@index([jobPositionId, status])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([uid])
  @@index([appliedAt])
  @@map("Application")
}

enum ApplicationStatus {
  PENDING
  REVIEWED
  REJECTED
  ACCEPTED
}

enum EmailTemplateType {
  APPLICATION_RECEIVED
  APPLICATION_REJECTED
  APPLICATION_SHORTLISTED
  INTERVIEW_INVITATION
  INTERVIEW_REMINDER
  OFFER_LETTER
  CUSTOM
}

model EmailTemplate {
  id          Int                @id @default(autoincrement())
  uid         String             @unique @default(uuid()) @db.Uuid
  name        String
  subject     String
  body        String             @db.Text
  type        EmailTemplateType?
  companyId   Int?
  company     Company?           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdById Int
  createdBy   User               @relation("EmailTemplateCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  isDefault   Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([name, companyId])
  @@index([companyId])
  @@index([createdById])
  @@index([isDefault])
  @@index([uid])
  @@index([createdAt])
  @@index([type])
}

model EmailLog {
  id              Int      @id @default(autoincrement())
  uid             String   @unique @default(uuid()) @db.Uuid
  recipientEmail  String
  recipientName   String
  subject         String
  template        String   @db.Text
  status          String   @default("SENT")
  emailType       String
  relatedEntity   String?
  relatedEntityId String?
  sentAt          DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([recipientEmail])
  @@index([sentAt])
  @@index([emailType])
  @@index([relatedEntityId])
  @@index([uid])
  @@index([status])
}

model Interview {
  id                    Int                     @id @default(autoincrement())
  uid                   String                  @unique @default(uuid()) @db.Uuid
  stageId               Int
  stage                 Stage                   @relation("StageInterviews", fields: [stageId], references: [id], onDelete: Cascade)
  scheduledDate         DateTime?
  scheduledTime         String?
  duration              Int?
  status                InterviewStatus         @default(PENDING)
  deletedAt             DateTime?
  meetingLink           String?                 @db.Text
  calendarEventId       String?
  location              String?
  notes                 String?                 @db.Text
  scheduledById         Int
  scheduledBy           User                    @relation("InterviewScheduledBy", fields: [scheduledById], references: [id], onDelete: Restrict)
  interviewers          InterviewInterviewer[]  @relation("InterviewInterviewers")
  scorecards            Scorecard[]
  timeSlots             InterviewTimeSlot[]     @relation("InterviewTimeSlots")
  bookingTokens         InterviewBookingToken[] @relation("InterviewBookingTokens")
  rescheduledCount      Int                     @default(0)
  originalScheduledDate DateTime?
  lastRescheduledAt     DateTime?
  rescheduledReason     String?                 @db.Text
  reschedules           InterviewReschedule[]   @relation("InterviewReschedules")
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@index([stageId])
  @@index([scheduledById])
  @@index([status])
  @@index([scheduledDate])
  @@index([deletedAt])
  @@index([uid])
  @@index([createdAt])
  @@index([stageId, status])
}

model InterviewReschedule {
  id               Int       @id @default(autoincrement())
  uid              String    @unique @default(uuid()) @db.Uuid
  interviewId      Int
  interview        Interview @relation("InterviewReschedules", fields: [interviewId], references: [id], onDelete: Cascade)
  oldScheduledDate DateTime
  oldScheduledTime String
  newScheduledDate DateTime
  newScheduledTime String
  reason           String?   @db.Text
  rescheduledById  Int
  rescheduledBy    User      @relation("InterviewReschedules", fields: [rescheduledById], references: [id], onDelete: Restrict)
  rescheduledAt    DateTime  @default(now())

  @@index([interviewId])
  @@index([rescheduledById])
  @@index([rescheduledAt])
  @@index([uid])
}

model InterviewTimeSlot {
  id          Int       @id @default(autoincrement())
  uid         String    @unique @default(uuid()) @db.Uuid
  interviewId Int
  interview   Interview @relation("InterviewTimeSlots", fields: [interviewId], references: [id], onDelete: Cascade)
  startTime   DateTime
  endTime     DateTime
  isAvailable Boolean   @default(true)
  selectedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([interviewId])
  @@index([startTime])
  @@index([isAvailable])
  @@index([uid])
}

model InterviewBookingToken {
  id          Int       @id @default(autoincrement())
  uid         String    @unique @default(uuid()) @db.Uuid
  token       String    @unique
  interviewId Int
  interview   Interview @relation("InterviewBookingTokens", fields: [interviewId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([token])
  @@index([interviewId])
  @@index([expiresAt])
  @@index([uid])
}

model InterviewInterviewer {
  id          Int       @id @default(autoincrement())
  interviewId Int
  interview   Interview @relation("InterviewInterviewers", fields: [interviewId], references: [id], onDelete: Cascade)
  userId      Int
  user        User      @relation("InterviewParticipations", fields: [userId], references: [id], onDelete: Cascade)
  role        String?
  createdAt   DateTime  @default(now())

  @@unique([interviewId, userId])
  @@index([userId])
  @@index([interviewId])
}

enum InterviewStatus {
  PENDING
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Profile {
  id          Int      @id @default(autoincrement())
  uid         String   @unique @default(uuid()) @db.Uuid
  bio         String?  @db.Text
  phone       String?
  location    String?
  timezone    String?  @default("UTC")
  preferences Json?    @default("{}")
  userId      Int      @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
}

model UserActivityLog {
  id        Int      @id @default(autoincrement())
  uid       String   @unique @default(uuid()) @db.Uuid
  userId    Int
  user      User     @relation("UserActivityLogs", fields: [userId], references: [id], onDelete: Cascade)
  action    String
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([uid])
}

model HRSchedule {
  id           Int       @id @default(autoincrement())
  uid          String    @unique @default(uuid()) @db.Uuid
  userId       Int
  user         User      @relation("UserSchedules", fields: [userId], references: [id], onDelete: Cascade)
  dayOfWeek    Int
  startTime    String
  endTime      String
  isRecurring  Boolean   @default(true)
  specificDate DateTime?
  isAvailable  Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([dayOfWeek])
  @@index([specificDate])
  @@index([uid])
  @@index([isAvailable])
}

model ScorecardTemplate {
  id          Int                 @id @default(autoincrement())
  uid         String              @unique @default(uuid()) @db.Uuid
  name        String
  description String?             @db.Text
  companyId   Int?
  company     Company?            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  isActive    Boolean             @default(true)
  categories  ScorecardCategory[]
  submissions Scorecard[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([companyId])
  @@index([isActive])
  @@index([uid])
  @@index([createdAt])
  @@index([name])
}

model ScorecardCategory {
  id         Int                  @id @default(autoincrement())
  uid        String               @unique @default(uuid()) @db.Uuid
  templateId Int
  template   ScorecardTemplate    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name       String
  weight     Int
  order      Int                  @default(0)
  criteria   ScorecardCriterion[]
  createdAt  DateTime             @default(now())

  @@index([templateId])
  @@index([uid])
  @@index([order])
}

model ScorecardCriterion {
  id          Int               @id @default(autoincrement())
  uid         String            @unique @default(uuid()) @db.Uuid
  categoryId  Int
  category    ScorecardCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  description String?           @db.Text
