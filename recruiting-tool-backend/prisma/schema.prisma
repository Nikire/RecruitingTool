generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

// Database connection with connection pooling
// Connection pool is configured via DATABASE_URL query parameters or PrismaClient options
// See: https://www.prisma.io/docs/concepts/components/prisma-client/working-with-prismaclient/connection-management
//
// Recommended DATABASE_URL format with connection pooling:
// postgresql://user:password@host:5432/dbname?connection_limit=10&pool_timeout=60&connect_timeout=10
//
// Connection pool configuration (via environment variables):
// - DATABASE_POOL_MIN: Minimum connections to maintain (default: 2)
// - DATABASE_POOL_MAX: Maximum connections allowed (dev: 10, prod: 20)
// - DATABASE_POOL_ACQUIRE_TIMEOUT: Time to wait for available connection (default: 60s)
// - DATABASE_POOL_IDLE_TIMEOUT: Time before idle connection is closed (default: 10min)
// - DATABASE_POOL_MAX_LIFETIME: Time before connection is recycled (default: 30min)
//
// PostgreSQL connection limits:
// - PostgreSQL default max_connections: 100
// - Docker container default: 100
// - Reserve ~30% for other connections (pgAdmin, migrations, etc.)
// - Development pool max: 10 connections
// - Production pool max: 20 connections
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                 Int                 @id @default(autoincrement())
  uid                String              @unique @default(uuid()) @db.Uuid
  name               String
  description        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  users              User[]
  jobPositions       JobPosition[]
  hiringProcesses    HiringProcess[]
  emailTemplates     EmailTemplate[]
  scorecardTemplates ScorecardTemplate[]
  aiQuotas           AIQuota[]
  aiUsageLogs        AIUsageLog[]
  subscription       Subscription?

  @@index([uid])
  @@index([name])
  @@index([createdAt])
}

model User {
  id                      Int                    @id @default(autoincrement())
  uid                     String                 @unique @default(uuid()) @db.Uuid
  name                    String
  email                   String
  password                String
  roles                   RolesType[]            @default([USER])
  profilePicture          String?
  phoneNumber             String?
  position                String?
  department              String?
  bio                     String?
  linkedinUrl             String?
  timezone                String?
  googleRefreshToken      String?
  isActive                Boolean                @default(true)
  deactivatedAt           DateTime?
  deactivatedBy           Int?
  lastLoginAt             DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  companyId               Int?
  company                 Company?               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  profile                 Profile?
  jobPositions            JobPosition[]          @relation("JobPositionsUser")
  fileUploads             FileUpload[]           @relation("FileUploadsUser")
  reviewedApplications    Application[]          @relation("ApplicationReviewer")
  candidateNotes          CandidateNote[]        @relation("CandidateNoteAuthor")
  emailTemplates          EmailTemplate[]        @relation("EmailTemplateCreatedBy")
  scheduledInterviews     Interview[]            @relation("InterviewScheduledBy")
  interviewParticipations InterviewInterviewer[] @relation("InterviewParticipations")
  interviewReschedules    InterviewReschedule[]  @relation("InterviewReschedules")
  stageNotes              StageNote[]            @relation("StageNoteAuthor")
  activityLogs            UserActivityLog[]      @relation("UserActivityLogs")
  schedules               HRSchedule[]           @relation("UserSchedules")
  scorecardEvaluations    Scorecard[]            @relation("ScorecardEvaluations")
  aiUsageLogs             AIUsageLog[]           @relation("UserAIUsageLogs")
  candidateActivities     CandidateActivity[]    @relation("CandidateActivityUser")
  refreshTokens           RefreshToken[]         @relation("UserRefreshTokens")
  auditLogs               AuditLog[]             @relation("UserAuditLogs")
  calendarConnections     CalendarConnection[]   @relation("UserCalendarConnections")

  @@unique([email, companyId])
  @@index([email])
  @@index([companyId])
  @@index([isActive])
  @@index([roles])
  @@index([uid])
  @@index([companyId, isActive])
  @@index([createdAt])
  @@index([lastLoginAt])
  @@map("User")
}

model Candidate {
  id              Int                 @id @default(autoincrement())
  uid             String              @unique @default(uuid()) @db.Uuid
  name            String
  email           String              @unique
  source          ApplicationSource?  @default(DIRECT_APPLY)
  sourceDetails   String?
  sourceUrl       String?
  deletedAt       DateTime?
  hiringProcesses HiringProcess[]     @relation("HiringProcessCandidate")
  files           FileUpload[]        @relation("CandidateFiles")
  notes           CandidateNote[]     @relation("CandidateNotes")
  stageTimeLogs   StageTimeLog[]      @relation("CandidateStageTimeLogs")
  scores          CandidateScore[]    @relation("CandidateScores")
  activities      CandidateActivity[] @relation("CandidateActivities")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([email])
  @@index([source])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([uid])
  @@map("Candidate")
}

model CandidateNote {
  id          Int       @id @default(autoincrement())
  uid         String    @unique @default(uuid()) @db.Uuid
  content     String    @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  candidateId Int
  candidate   Candidate @relation("CandidateNotes", fields: [candidateId], references: [id], onDelete: Cascade)
  authorId    Int?
  author      User?     @relation("CandidateNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([candidateId])
  @@index([authorId])
  @@index([uid])
  @@index([createdAt])
}

enum RolesType {
  USER
  ADMIN
  SUPER_ADMIN
  HR
  COMPANY_OWNER
}

enum ApplicationSource {
  WEBSITE
  LINKEDIN
  INDEED
  GLASSDOOR
  REFERRAL
  JOB_FAIR
  UNIVERSITY
  RECRUITER
  DIRECT_APPLY
  SOCIAL_MEDIA
  MANUAL
  CSV_IMPORT
  OTHER
}

model JobPosition {
  id               Int               @id @default(autoincrement())
  uid              String            @unique @default(uuid()) @db.Uuid
  title            String
  description      String?
  customQuestions  Json?             @default("[]")
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  createdById      Int
  createdBy        User              @relation("JobPositionsUser", fields: [createdById], references: [id], onDelete: Restrict)
  companyId        Int
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  stages           Stage[]
  status           JobPositionStatus @default(OPEN)
  hiringProcesses  HiringProcess[]
  applications     Application[]
  candidateScores  CandidateScore[]  @relation("JobPositionScores")
  batchScoringJobs BatchScoringJob[] @relation("BatchScoringJobs")

  @@index([status])
  @@index([companyId])
  @@index([createdById])
  @@index([companyId, status])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([companyId, deletedAt])
  @@index([uid])
  @@index([title])
}

model HiringProcess {
  id            Int                 @id @default(autoincrement())
  uid           String              @unique @default(uuid()) @db.Uuid
  title         String
  status        HiringProcessStatus @default(OPEN)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  candidateId   Int?
  candidate     Candidate?          @relation("HiringProcessCandidate", fields: [candidateId], references: [id], onDelete: SetNull)
  stages        Stage[]
  jobPosition   JobPosition         @relation(fields: [jobPositionId], references: [id], onDelete: SetNull)
  jobPositionId Int
  companyId     Int
  company       Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([candidateId, jobPositionId])
  @@index([status])
  @@index([jobPositionId])
  @@index([candidateId])
  @@index([companyId])
  @@index([companyId, status])
  @@index([createdAt])
  @@index([uid])
  @@index([jobPositionId, status])
  @@index([candidateId, status])
}

enum HiringProcessStatus {
  OPEN
  CLOSED
  IN_PROGRESS
  CANCELLED
  REJECTED
}

enum JobPositionStatus {
  OPEN
  CLOSED
  CANCELLED
}

model Stage {
  id              Int            @id @default(autoincrement())
  uid             String         @unique @default(uuid()) @db.Uuid
  title           String
  type            StageType
  description     String
  status          StageStatus    @default(OPEN)
  deletedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  hiringProcess   HiringProcess? @relation(fields: [hiringProcessId], references: [id], onDelete: Cascade)
  hiringProcessId Int?
  position        Int
  JobPosition     JobPosition?   @relation(fields: [jobPositionId], references: [id], onDelete: SetNull)
  jobPositionId   Int?
  estimatedTime   Int?
  interviews      Interview[]    @relation("StageInterviews")
  notes           StageNote[]    @relation("StageNotes")
  timeLogs        StageTimeLog[] @relation("StageTimeLogs")

  @@unique([hiringProcessId, position])
  @@index([hiringProcessId])
  @@index([jobPositionId])
  @@index([status])
  @@index([position])
  @@index([hiringProcessId, position])
  @@index([deletedAt])
  @@index([uid])
  @@index([type])
  @@index([createdAt])
}

model StageNote {
  id        Int      @id @default(autoincrement())
  uid       String   @unique @default(uuid()) @db.Uuid
  content   String   @db.Text
  stageId   Int
  stage     Stage    @relation("StageNotes", fields: [stageId], references: [id], onDelete: Cascade)
  authorId  Int
  author    User     @relation("StageNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stageId])
  @@index([authorId])
  @@index([uid])
  @@index([createdAt])
}

enum StageStatus {
  OPEN
  CURRENT
  CANCELLED
  DONE
}

enum StageType {
  INTERVIEW
  TECHNICAL_INTERVIEW
  FINAL_INTERVIEW
  OFFER
}

model FileUpload {
  id                 Int           @id @default(autoincrement())
  uid                String        @unique @default(uuid()) @db.Uuid
  filename           String
  originalName       String
  mimetype           String
  size               Int
  s3Key              String
  hash               String? // SHA-256 hash for deduplication (optional for backward compatibility)
  uploadedByPublic   Boolean       @default(false)
  uploadedById       Int?
  uploadedBy         User?         @relation("FileUploadsUser", fields: [uploadedById], references: [id], onDelete: Restrict)
  candidateId        Int?
  candidate          Candidate?    @relation("CandidateFiles", fields: [candidateId], references: [id], onDelete: Cascade)
  applicationResumes Application[] @relation("ApplicationResume")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([candidateId])
  @@index([uploadedById])
  @@index([uid])
  @@index([createdAt])
  @@index([uploadedByPublic])
  @@index([hash])
}

model Application {
  id             Int               @id @default(autoincrement())
  uid            String            @unique @default(uuid()) @db.Uuid
  jobPositionId  Int?
  jobPosition    JobPosition?      @relation(fields: [jobPositionId], references: [id], onDelete: SetNull)
  applicantName  String
  applicantEmail String
  applicantPhone String
  resumeFileId   Int?
  resumeFile     FileUpload?       @relation("ApplicationResume", fields: [resumeFileId], references: [id], onDelete: SetNull)
  coverLetter    String?           @db.Text
  customAnswers  Json?             @default("{}")
  status         ApplicationStatus @default(PENDING)
  deletedAt      DateTime?
  appliedAt      DateTime          @default(now())
  reviewedAt     DateTime?
  reviewedById   Int?
  reviewedBy     User?             @relation("ApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  notes          String?           @db.Text
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([jobPositionId, applicantEmail])
  @@index([status])
  @@index([jobPositionId])
  @@index([applicantEmail])
  @@index([reviewedById])
  @@index([jobPositionId, status])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([uid])
  @@index([appliedAt])
  @@map("Application")
}

enum ApplicationStatus {
  PENDING
  REVIEWED
  REJECTED
  ACCEPTED
}

model EmailTemplate {
  id          Int      @id @default(autoincrement())
  uid         String   @unique @default(uuid()) @db.Uuid
  name        String
  subject     String
  body        String   @db.Text
  companyId   Int?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdById Int
  createdBy   User     @relation("EmailTemplateCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name, companyId])
  @@index([companyId])
  @@index([createdById])
  @@index([isDefault])
  @@index([uid])
  @@index([createdAt])
}

model EmailLog {
  id              Int      @id @default(autoincrement())
  uid             String   @unique @default(uuid()) @db.Uuid
  recipientEmail  String
  recipientName   String
  subject         String
  template        String   @db.Text
  status          String   @default("SENT")
  emailType       String
  relatedEntity   String?
  relatedEntityId String?
  sentAt          DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([recipientEmail])
  @@index([sentAt])
  @@index([emailType])
  @@index([relatedEntityId])
  @@index([uid])
  @@index([status])
}

model Interview {
  id                    Int                     @id @default(autoincrement())
  uid                   String                  @unique @default(uuid()) @db.Uuid
  stageId               Int
  stage                 Stage                   @relation("StageInterviews", fields: [stageId], references: [id], onDelete: Cascade)
  scheduledDate         DateTime?
  scheduledTime         String?
  duration              Int?
  status                InterviewStatus         @default(PENDING)
  deletedAt             DateTime?
  meetingLink           String?                 @db.Text
  location              String?
  notes                 String?                 @db.Text
  scheduledById         Int
  scheduledBy           User                    @relation("InterviewScheduledBy", fields: [scheduledById], references: [id], onDelete: Restrict)
  interviewers          InterviewInterviewer[]  @relation("InterviewInterviewers")
  scorecards            Scorecard[]
  timeSlots             InterviewTimeSlot[]     @relation("InterviewTimeSlots")
  bookingTokens         InterviewBookingToken[] @relation("InterviewBookingTokens")
  rescheduledCount      Int                     @default(0)
  originalScheduledDate DateTime?
  lastRescheduledAt     DateTime?
  rescheduledReason     String?                 @db.Text
  reschedules           InterviewReschedule[]   @relation("InterviewReschedules")
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@index([stageId])
  @@index([scheduledById])
  @@index([status])
  @@index([scheduledDate])
  @@index([deletedAt])
  @@index([uid])
  @@index([createdAt])
  @@index([stageId, status])
}

model InterviewReschedule {
  id               Int       @id @default(autoincrement())
  uid              String    @unique @default(uuid()) @db.Uuid
  interviewId      Int
  interview        Interview @relation("InterviewReschedules", fields: [interviewId], references: [id], onDelete: Cascade)
  oldScheduledDate DateTime
  oldScheduledTime String
  newScheduledDate DateTime
  newScheduledTime String
  reason           String?   @db.Text
  rescheduledById  Int
  rescheduledBy    User      @relation("InterviewReschedules", fields: [rescheduledById], references: [id], onDelete: Restrict)
  rescheduledAt    DateTime  @default(now())

  @@index([interviewId])
  @@index([rescheduledById])
  @@index([rescheduledAt])
  @@index([uid])
}

model InterviewTimeSlot {
  id          Int       @id @default(autoincrement())
  uid         String    @unique @default(uuid()) @db.Uuid
  interviewId Int
  interview   Interview @relation("InterviewTimeSlots", fields: [interviewId], references: [id], onDelete: Cascade)
  startTime   DateTime
  endTime     DateTime
  isAvailable Boolean   @default(true)
  selectedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([interviewId])
  @@index([startTime])
  @@index([isAvailable])
  @@index([uid])
}

model InterviewBookingToken {
  id          Int       @id @default(autoincrement())
  uid         String    @unique @default(uuid()) @db.Uuid
  token       String    @unique
  interviewId Int
  interview   Interview @relation("InterviewBookingTokens", fields: [interviewId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([token])
  @@index([interviewId])
  @@index([expiresAt])
  @@index([uid])
}

model InterviewInterviewer {
  id          Int       @id @default(autoincrement())
  interviewId Int
  interview   Interview @relation("InterviewInterviewers", fields: [interviewId], references: [id], onDelete: Cascade)
  userId      Int
  user        User      @relation("InterviewParticipations", fields: [userId], references: [id], onDelete: Cascade)
  role        String?
  createdAt   DateTime  @default(now())

  @@unique([interviewId, userId])
  @@index([userId])
  @@index([interviewId])
}

enum InterviewStatus {
  PENDING
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Profile {
  id          Int      @id @default(autoincrement())
  uid         String   @unique @default(uuid()) @db.Uuid
  bio         String?  @db.Text
  phone       String?
  location    String?
  timezone    String?  @default("UTC")
  preferences Json?    @default("{}")
  userId      Int      @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
}

model UserActivityLog {
  id        Int      @id @default(autoincrement())
  uid       String   @unique @default(uuid()) @db.Uuid
  userId    Int
  user      User     @relation("UserActivityLogs", fields: [userId], references: [id], onDelete: Cascade)
  action    String
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([uid])
}

model HRSchedule {
  id           Int       @id @default(autoincrement())
  uid          String    @unique @default(uuid()) @db.Uuid
  userId       Int
  user         User      @relation("UserSchedules", fields: [userId], references: [id], onDelete: Cascade)
  dayOfWeek    Int
  startTime    String
  endTime      String
  isRecurring  Boolean   @default(true)
  specificDate DateTime?
  isAvailable  Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([dayOfWeek])
  @@index([specificDate])
  @@index([uid])
  @@index([isAvailable])
}

model ScorecardTemplate {
  id          Int                 @id @default(autoincrement())
  uid         String              @unique @default(uuid()) @db.Uuid
  name        String
  description String?             @db.Text
  companyId   Int?
  company     Company?            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  isActive    Boolean             @default(true)
  categories  ScorecardCategory[]
  submissions Scorecard[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([companyId])
  @@index([isActive])
  @@index([uid])
  @@index([createdAt])
  @@index([name])
}

model ScorecardCategory {
  id         Int                  @id @default(autoincrement())
  uid        String               @unique @default(uuid()) @db.Uuid
  templateId Int
  template   ScorecardTemplate    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name       String
  weight     Int
  order      Int                  @default(0)
  criteria   ScorecardCriterion[]
  createdAt  DateTime             @default(now())

  @@index([templateId])
  @@index([uid])
  @@index([order])
}

model ScorecardCriterion {
  id          Int               @id @default(autoincrement())
  uid         String            @unique @default(uuid()) @db.Uuid
  categoryId  Int
  category    ScorecardCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  description String?           @db.Text
  maxScore    Int               @default(5)
  order       Int               @default(0)
  createdAt   DateTime          @default(now())

  @@index([categoryId])
  @@index([uid])
  @@index([order])
}

model Scorecard {
  id           Int               @id @default(autoincrement())
  uid          String            @unique @default(uuid()) @db.Uuid
  templateId   Int
  template     ScorecardTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  interviewId  Int?
  interview    Interview?        @relation(fields: [interviewId], references: [id], onDelete: SetNull)
  evaluatorId  Int
  evaluator    User              @relation("ScorecardEvaluations", fields: [evaluatorId], references: [id], onDelete: Restrict)
  overallScore Float?
  notes        String?           @db.Text
  scores       ScorecardScore[]
  submittedAt  DateTime          @default(now())
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([templateId])
  @@index([interviewId])
  @@index([evaluatorId])
  @@index([uid])
  @@index([submittedAt])
  @@index([createdAt])
}

model ScorecardScore {
  id          Int       @id @default(autoincrement())
  scorecardId Int
  scorecard   Scorecard @relation(fields: [scorecardId], references: [id], onDelete: Cascade)
  criterionId Int
  score       Int
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())

  @@unique([scorecardId, criterionId])
  @@index([scorecardId])
  @@index([score])
}

model AIQuota {
  id        Int       @id @default(autoincrement())
  uid       String    @unique @default(uuid()) @db.Uuid
  companyId Int
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quotaType QuotaType
  limit     Int
  used      Int       @default(0)
  resetDate DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([companyId, quotaType])
  @@index([companyId])
  @@index([quotaType])
  @@index([uid])
}

enum QuotaType {
  RESUME_PARSING
  CANDIDATE_SCORING
  BATCH_SCORING
}

model AIUsageLog {
  id         Int       @id @default(autoincrement())
  uid        String    @unique @default(uuid()) @db.Uuid
  companyId  Int
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId     Int
  user       User      @relation("UserAIUsageLogs", fields: [userId], references: [id], onDelete: Cascade)
  operation  QuotaType
  tokensUsed Int?
  cost       Float?
  createdAt  DateTime  @default(now())

  @@index([companyId])
  @@index([userId])
  @@index([operation])
  @@index([createdAt])
  @@index([uid])
}

model StageTimeLog {
  id          Int       @id @default(autoincrement())
  uid         String    @unique @default(uuid()) @db.Uuid
  stageId     Int
  stage       Stage     @relation("StageTimeLogs", fields: [stageId], references: [id], onDelete: Cascade)
  candidateId Int
  candidate   Candidate @relation("CandidateStageTimeLogs", fields: [candidateId], references: [id], onDelete: SetNull)
  enteredAt   DateTime  @default(now())
  exitedAt    DateTime?
  duration    Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([stageId])
  @@index([candidateId])
  @@index([enteredAt])
  @@index([uid])
}

model CandidateScore {
  id              Int          @id @default(autoincrement())
  uid             String       @unique @default(uuid()) @db.Uuid
  candidateId     Int?
  candidate       Candidate?   @relation("CandidateScores", fields: [candidateId], references: [id], onDelete: SetNull)
  jobPositionId   Int?
  jobPosition     JobPosition? @relation("JobPositionScores", fields: [jobPositionId], references: [id], onDelete: SetNull)
  overallScore    Float
  skillsScore     Float
  experienceScore Float
  educationScore  Float
  analysis        Json?
  scoredAt        DateTime     @default(now())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([candidateId, jobPositionId])
  @@index([jobPositionId])
  @@index([overallScore])
  @@index([candidateId])
  @@index([uid])
}

model BatchScoringJob {
  id              Int          @id @default(autoincrement())
  uid             String       @unique @default(uuid()) @db.Uuid
  jobPositionId   Int?
  jobPosition     JobPosition? @relation("BatchScoringJobs", fields: [jobPositionId], references: [id], onDelete: SetNull)
  status          BatchStatus  @default(PENDING)
  priority        String       @default("normal")
  totalCandidates Int
  processedCount  Int          @default(0)
  failedCount     Int          @default(0)
  candidateUids   Json
  errors          Json?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([status])
  @@index([jobPositionId])
  @@index([priority])
  @@index([uid])
}

enum BatchStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum CandidateActivityType {
  CREATED
  STAGE_CHANGED
  STATUS_CHANGED
  INTERVIEW_SCHEDULED
  INTERVIEW_UPDATED
  INTERVIEW_CANCELLED
  INTERVIEW_COMPLETED
  NOTE_ADDED
  APPLICATION_RECEIVED
  EMAIL_SENT
}

model CandidateActivity {
  id          Int                   @id @default(autoincrement())
  uid         String                @unique @default(uuid()) @db.Uuid
  candidateId Int
  candidate   Candidate             @relation("CandidateActivities", fields: [candidateId], references: [id], onDelete: Cascade)
  type        CandidateActivityType
  description String
  metadata    Json?
  userId      Int?
  user        User?                 @relation("CandidateActivityUser", fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime              @default(now())

  @@index([candidateId])
  @@index([type])
  @@index([createdAt])
  @@index([userId])
  @@index([uid])
}

model RefreshToken {
  id         Int       @id @default(autoincrement())
  uid        String    @unique @default(uuid()) @db.Uuid
  token      String    @unique
  userId     Int
  user       User      @relation("UserRefreshTokens", fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  replacedBy String?

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@index([uid])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  uid        String   @unique @default(uuid()) @db.Uuid
  action     String
  entityType String
  entityId   Int
  entityUid  String
  userId     Int
  user       User     @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: Cascade)
  timestamp  DateTime @default(now())
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityUid])
  @@index([userId])
  @@index([timestamp])
  @@index([action])
  @@index([uid])
  @@index([entityType])
  @@index([entityUid])
}

enum CalendarProvider {
  GOOGLE
  OUTLOOK
}

model CalendarConnection {
  id           Int              @id @default(autoincrement())
  uid          String           @unique @default(uuid()) @db.Uuid
  userId       Int
  user         User             @relation("UserCalendarConnections", fields: [userId], references: [id], onDelete: Cascade)
  provider     CalendarProvider
  accessToken  String?          @db.Text
  refreshToken String           @db.Text
  tokenExpiry  DateTime?
  email        String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([userId, provider])
  @@index([userId])
  @@index([provider])
  @@index([uid])
  @@index([tokenExpiry])
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

enum SubscriptionPlan {
  FREE
  PROFESSIONAL
  ENTERPRISE
}

model Subscription {
  id                   Int                @id @default(autoincrement())
  uid                  String             @unique @default(uuid()) @db.Uuid
  companyId            Int                @unique
  company              Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  status               SubscriptionStatus @default(TRIALING)
  plan                 SubscriptionPlan   @default(FREE)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  trialEnd             DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([companyId])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@index([status])
  @@index([plan])
  @@index([uid])
  @@index([currentPeriodEnd])
}
