model Subscription {
  id                   Int                @id @default(autoincrement())
  uid                  String             @unique @default(uuid()) @db.Uuid
  companyId            Int                @unique
  company              Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  status               SubscriptionStatus @default(TRIALING)
  plan                 SubscriptionPlan   @default(FREE)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  trialEnd             DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  gracePeriodEndsAt    DateTime?
  subscriptionEndsAt   DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([companyId])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@index([status])
  @@index([plan])
  @@index([uid])
  @@index([currentPeriodEnd])
  @@index([gracePeriodEndsAt])
  @@index([subscriptionEndsAt])
}

model ConnectionRequest {
  id            Int                     @id @default(autoincrement())
  uid           String                  @unique @default(uuid()) @db.Uuid
  userId        Int
  user          User                    @relation("UserConnectionRequests", fields: [userId], references: [id], onDelete: Cascade)
  companyId     Int
  company       Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requestedRole RolesType               @default(HR)
  status        ConnectionRequestStatus @default(PENDING)
  message       String?                 @db.Text
  reviewedById  Int?
  reviewedBy    User?                   @relation("ReviewedConnectionRequests", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  reviewNote    String?                 @db.Text
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@unique([userId, companyId])
  @@index([companyId, status])
  @@index([userId])
  @@index([status])
  @@index([uid])
  @@index([createdAt])
}

enum ConnectionRequestStatus {
  PENDING
  APPROVED
  DENIED
  CANCELLED
}

model CompanyInvitation {
