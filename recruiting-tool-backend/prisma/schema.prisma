generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id              Int             @id @default(autoincrement())
  uid             String          @unique @default(uuid()) @db.Uuid
  name            String
  description     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  users           User[]
  jobPositions    JobPosition[]
  hiringProcesses HiringProcess[]
  emailTemplates  EmailTemplate[]
}

model User {
  id                    Int             @id @default(autoincrement())
  uid                   String          @unique @default(uuid()) @db.Uuid
  name                  String
  email                 String          @unique
  password              String
  roles                 RolesType[]     @default([USER])
  profilePicture        String?
  phoneNumber           String?
  position              String?
  department            String?
  bio                   String?
  linkedinUrl           String?
  timezone              String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  companyId             Int?
  company               Company?        @relation(fields: [companyId], references: [id])
  jobPositions          JobPosition[]   @relation("JobPositionsUser")
  fileUploads           FileUpload[]    @relation("FileUploadsUser")
  reviewedApplications  Application[]   @relation("ApplicationReviewer")
  candidateNotes        CandidateNote[] @relation("CandidateNoteAuthor")
  emailTemplates        EmailTemplate[] @relation("EmailTemplateCreatedBy")
}

model Candidate {
  id              Int             @id @default(autoincrement())
  uid             String          @unique @default(uuid()) @db.Uuid
  name            String
  email           String
  hiringProcessId Int?            @unique
  hiringProcess   HiringProcess?  @relation("HiringProcessCandidate", fields: [hiringProcessId], references: [id])
  files           FileUpload[]    @relation("CandidateFiles")
  notes           CandidateNote[] @relation("CandidateNotes")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([hiringProcessId, email])
}

model CandidateNote {
  id          Int       @id @default(autoincrement())
  uid         String    @unique @default(uuid()) @db.Uuid
  content     String    @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  candidateId Int
  candidate   Candidate @relation("CandidateNotes", fields: [candidateId], references: [id], onDelete: Cascade)
  authorId    Int
  author      User      @relation("CandidateNoteAuthor", fields: [authorId], references: [id])

  @@index([candidateId])
  @@index([authorId])
}

enum RolesType {
  USER
  ADMIN
  SUPER_ADMIN
  HR
}

model JobPosition {
  id              Int               @id @default(autoincrement())
  uid             String            @unique @default(uuid()) @db.Uuid
  title           String
  description     String?
  customQuestions Json?             @default("[]")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  createdById     Int
  createdBy       User              @relation("JobPositionsUser", fields: [createdById], references: [id])
  companyId       Int
  company         Company           @relation(fields: [companyId], references: [id])
  stages          Stage[]
  status          JobPositionStatus @default(OPEN)
  hiringProcesses HiringProcess[]
  applications    Application[]
}

model HiringProcess {
  id            Int                 @id @default(autoincrement())
  uid           String              @unique @default(uuid()) @db.Uuid
  title         String
  status        HiringProcessStatus @default(OPEN)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  candidateId   Int?                @unique
  candidate     Candidate?          @relation("HiringProcessCandidate")
  stages        Stage[]
  jobPosition   JobPosition         @relation(fields: [jobPositionId], references: [id])
  jobPositionId Int
  companyId     Int
  company       Company             @relation(fields: [companyId], references: [id])
}

enum HiringProcessStatus {
  OPEN
  CLOSED
  IN_PROGRESS
  CANCELLED
  REJECTED
}

enum JobPositionStatus {
  OPEN
  CLOSED
  CANCELLED
}

model Stage {
  id              Int            @id @default(autoincrement())
  uid             String         @unique @default(uuid()) @db.Uuid
  title           String
  type            StageType
  description     String
  status          StageStatus    @default(OPEN)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  hiringProcess   HiringProcess? @relation(fields: [hiringProcessId], references: [id])
  hiringProcessId Int?
  position        Int
  JobPosition     JobPosition?   @relation(fields: [jobPositionId], references: [id])
  jobPositionId   Int?
  estimatedTime   Int?

  @@unique([hiringProcessId, position])
}

enum StageStatus {
  OPEN
  CURRENT
  CANCELLED
  DONE
}

enum StageType {
  INTERVIEW
  TECHNICAL_INTERVIEW
  FINAL_INTERVIEW
  OFFER
}

model FileUpload {
  id                 Int            @id @default(autoincrement())
  uid                String         @unique @default(uuid()) @db.Uuid
  filename           String
  originalName       String
  mimetype           String
  size               Int
  s3Key              String
  uploadedById       Int
  uploadedBy         User           @relation("FileUploadsUser", fields: [uploadedById], references: [id])
  candidateId        Int?
  candidate          Candidate?     @relation("CandidateFiles", fields: [candidateId], references: [id])
  applicationResumes Application[]  @relation("ApplicationResume")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model Application {
  id             Int               @id @default(autoincrement())
  uid            String            @unique @default(uuid()) @db.Uuid
  jobPositionId  Int
  jobPosition    JobPosition       @relation(fields: [jobPositionId], references: [id])
  applicantName  String
  applicantEmail String
  applicantPhone String
  resumeFileId   Int?
  resumeFile     FileUpload?       @relation("ApplicationResume", fields: [resumeFileId], references: [id])
  coverLetter    String?           @db.Text
  customAnswers  Json?             @default("{}")
  status         ApplicationStatus @default(PENDING)
  appliedAt      DateTime          @default(now())
  reviewedAt     DateTime?
  reviewedById   Int?
  reviewedBy     User?             @relation("ApplicationReviewer", fields: [reviewedById], references: [id])
  notes          String?           @db.Text
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

enum ApplicationStatus {
  PENDING
  REVIEWED
  REJECTED
  ACCEPTED
}

model EmailTemplate {
  id          Int      @id @default(autoincrement())
  uid         String   @unique @default(uuid()) @db.Uuid
  name        String
  subject     String
  body        String   @db.Text
  companyId   Int
  company     Company  @relation(fields: [companyId], references: [id])
  createdById Int
  createdBy   User     @relation("EmailTemplateCreatedBy", fields: [createdById], references: [id])
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@index([createdById])
}

model EmailLog {
  id              Int       @id @default(autoincrement())
  uid             String    @unique @default(uuid()) @db.Uuid
  recipientEmail  String
  recipientName   String
  subject         String
  template        String    @db.Text
  status          String    @default("SENT")
  emailType       String
  relatedEntity   String?
  relatedEntityId String?
  sentAt          DateTime  @default(now())
  createdAt       DateTime  @default(now())

  @@index([recipientEmail])
  @@index([sentAt])
  @@index([emailType])
  @@index([relatedEntityId])
}
