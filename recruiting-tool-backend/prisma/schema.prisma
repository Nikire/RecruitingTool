generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id              Int             @id @default(autoincrement())
  uid             String          @unique @default(uuid()) @db.Uuid
  name            String
  description     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  users           User[]
  jobPositions    JobPosition[]
  hiringProcesses HiringProcess[]
  emailTemplates  EmailTemplate[]
}

model User {
  id                    Int                    @id @default(autoincrement())
  uid                   String                 @unique @default(uuid()) @db.Uuid
  name                  String
  email                 String                 @unique
  password              String
  roles                 RolesType[]            @default([USER])
  profilePicture        String?
  phoneNumber           String?
  position              String?
  department            String?
  bio                   String?
  linkedinUrl           String?
  timezone              String?
  isActive              Boolean                @default(true)
  deactivatedAt         DateTime?
  deactivatedBy         Int?
  lastLoginAt           DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  companyId             Int?
  company               Company?               @relation(fields: [companyId], references: [id])
  profile               Profile?
  jobPositions          JobPosition[]          @relation("JobPositionsUser")
  fileUploads           FileUpload[]           @relation("FileUploadsUser")
  reviewedApplications  Application[]          @relation("ApplicationReviewer")
  candidateNotes        CandidateNote[]        @relation("CandidateNoteAuthor")
  emailTemplates        EmailTemplate[]        @relation("EmailTemplateCreatedBy")
  scheduledInterviews   Interview[]            @relation("InterviewScheduledBy")
  interviewParticipations InterviewInterviewer[] @relation("InterviewParticipations")
  stageNotes            StageNote[]            @relation("StageNoteAuthor")
  activityLogs          UserActivityLog[]      @relation("UserActivityLogs")
  schedules             HRSchedule[]           @relation("UserSchedules")
}

model Candidate {
  id              Int              @id @default(autoincrement())
  uid             String           @unique @default(uuid()) @db.Uuid
  name            String
  email           String           @unique
  hiringProcesses HiringProcess[]  @relation("HiringProcessCandidate")
  files           FileUpload[]     @relation("CandidateFiles")
  notes           CandidateNote[]  @relation("CandidateNotes")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model CandidateNote {
  id          Int       @id @default(autoincrement())
  uid         String    @unique @default(uuid()) @db.Uuid
  content     String    @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  candidateId Int
  candidate   Candidate @relation("CandidateNotes", fields: [candidateId], references: [id], onDelete: Cascade)
  authorId    Int
  author      User      @relation("CandidateNoteAuthor", fields: [authorId], references: [id])

  @@index([candidateId])
  @@index([authorId])
}

enum RolesType {
  USER
  ADMIN
  SUPER_ADMIN
  HR
}

model JobPosition {
  id              Int               @id @default(autoincrement())
  uid             String            @unique @default(uuid()) @db.Uuid
  title           String
  description     String?
  customQuestions Json?             @default("[]")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  createdById     Int
  createdBy       User              @relation("JobPositionsUser", fields: [createdById], references: [id])
  companyId       Int
  company         Company           @relation(fields: [companyId], references: [id])
  stages          Stage[]
  status          JobPositionStatus @default(OPEN)
  hiringProcesses HiringProcess[]
  applications    Application[]
}

model HiringProcess {
  id            Int                 @id @default(autoincrement())
  uid           String              @unique @default(uuid()) @db.Uuid
  title         String
  status        HiringProcessStatus @default(OPEN)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  candidateId   Int?
  candidate     Candidate?          @relation("HiringProcessCandidate", fields: [candidateId], references: [id])
  stages        Stage[]
  jobPosition   JobPosition         @relation(fields: [jobPositionId], references: [id], onDelete: Cascade)
  jobPositionId Int
  companyId     Int
  company       Company             @relation(fields: [companyId], references: [id])
}

enum HiringProcessStatus {
  OPEN
  CLOSED
  IN_PROGRESS
  CANCELLED
  REJECTED
}

enum JobPositionStatus {
  OPEN
  CLOSED
  CANCELLED
}

model Stage {
  id              Int            @id @default(autoincrement())
  uid             String         @unique @default(uuid()) @db.Uuid
  title           String
  type            StageType
  description     String
  status          StageStatus    @default(OPEN)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  hiringProcess   HiringProcess? @relation(fields: [hiringProcessId], references: [id], onDelete: Cascade)
  hiringProcessId Int?
  position        Int
  JobPosition     JobPosition?   @relation(fields: [jobPositionId], references: [id])
  jobPositionId   Int?
  estimatedTime   Int?
  interviews      Interview[]    @relation("StageInterviews")
  notes           StageNote[]    @relation("StageNotes")

  @@unique([hiringProcessId, position])
}

model StageNote {
  id        Int      @id @default(autoincrement())
  uid       String   @unique @default(uuid()) @db.Uuid
  content   String   @db.Text
  stageId   Int
  stage     Stage    @relation("StageNotes", fields: [stageId], references: [id], onDelete: Cascade)
  authorId  Int
  author    User     @relation("StageNoteAuthor", fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stageId])
  @@index([authorId])
}

enum StageStatus {
  OPEN
  CURRENT
  CANCELLED
  DONE
}

enum StageType {
  INTERVIEW
  TECHNICAL_INTERVIEW
  FINAL_INTERVIEW
  OFFER
}

model FileUpload {
  id                 Int            @id @default(autoincrement())
  uid                String         @unique @default(uuid()) @db.Uuid
  filename           String
  originalName       String
  mimetype           String
  size               Int
  s3Key              String
  uploadedById       Int
  uploadedBy         User           @relation("FileUploadsUser", fields: [uploadedById], references: [id])
  candidateId        Int?
  candidate          Candidate?     @relation("CandidateFiles", fields: [candidateId], references: [id])
  applicationResumes Application[]  @relation("ApplicationResume")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model Application {
  id             Int               @id @default(autoincrement())
  uid            String            @unique @default(uuid()) @db.Uuid
  jobPositionId  Int
  jobPosition    JobPosition       @relation(fields: [jobPositionId], references: [id], onDelete: Cascade)
  applicantName  String
  applicantEmail String
  applicantPhone String
  resumeFileId   Int?
  resumeFile     FileUpload?       @relation("ApplicationResume", fields: [resumeFileId], references: [id])
  coverLetter    String?           @db.Text
  customAnswers  Json?             @default("{}")
  status         ApplicationStatus @default(PENDING)
  appliedAt      DateTime          @default(now())
  reviewedAt     DateTime?
  reviewedById   Int?
  reviewedBy     User?             @relation("ApplicationReviewer", fields: [reviewedById], references: [id])
  notes          String?           @db.Text
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

enum ApplicationStatus {
  PENDING
  REVIEWED
  REJECTED
  ACCEPTED
}

model EmailTemplate {
  id          Int      @id @default(autoincrement())
  uid         String   @unique @default(uuid()) @db.Uuid
  name        String
  subject     String
  body        String   @db.Text
  companyId   Int
  company     Company  @relation(fields: [companyId], references: [id])
  createdById Int
  createdBy   User     @relation("EmailTemplateCreatedBy", fields: [createdById], references: [id])
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@index([createdById])
}

model EmailLog {
  id              Int       @id @default(autoincrement())
  uid             String    @unique @default(uuid()) @db.Uuid
  recipientEmail  String
  recipientName   String
  subject         String
  template        String    @db.Text
  status          String    @default("SENT")
  emailType       String
  relatedEntity   String?
  relatedEntityId String?
  sentAt          DateTime  @default(now())
  createdAt       DateTime  @default(now())

  @@index([recipientEmail])
  @@index([sentAt])
  @@index([emailType])
  @@index([relatedEntityId])
}

model Interview {
  id            Int                    @id @default(autoincrement())
  uid           String                 @unique @default(uuid()) @db.Uuid
  stageId       Int
  stage         Stage                  @relation("StageInterviews", fields: [stageId], references: [id], onDelete: Cascade)
  scheduledDate DateTime?
  scheduledTime String?
  duration      Int?
  status        InterviewStatus        @default(PENDING)
  meetingLink   String?                @db.Text
  location      String?
  notes         String?                @db.Text
  scheduledById Int
  scheduledBy   User                   @relation("InterviewScheduledBy", fields: [scheduledById], references: [id])
  interviewers  InterviewInterviewer[] @relation("InterviewInterviewers")
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([stageId])
  @@index([scheduledById])
  @@index([status])
  @@index([scheduledDate])
}

model InterviewInterviewer {
  id          Int       @id @default(autoincrement())
  interviewId Int
  interview   Interview @relation("InterviewInterviewers", fields: [interviewId], references: [id], onDelete: Cascade)
  userId      Int
  user        User      @relation("InterviewParticipations", fields: [userId], references: [id])
  role        String?
  createdAt   DateTime  @default(now())

  @@unique([interviewId, userId])
  @@index([userId])
  @@index([interviewId])
}

enum InterviewStatus {
  PENDING
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Profile {
  id          Int      @id @default(autoincrement())
  uid         String   @unique @default(uuid()) @db.Uuid
  bio         String?  @db.Text
  phone       String?
  location    String?
  timezone    String?  @default("UTC")
  preferences Json?    @default("{}")
  userId      Int      @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model UserActivityLog {
  id        Int      @id @default(autoincrement())
  uid       String   @unique @default(uuid()) @db.Uuid
  userId    Int
  user      User     @relation("UserActivityLogs", fields: [userId], references: [id], onDelete: Cascade)
  action    String
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model HRSchedule {
  id           Int       @id @default(autoincrement())
  uid          String    @unique @default(uuid()) @db.Uuid
  userId       Int
  user         User      @relation("UserSchedules", fields: [userId], references: [id], onDelete: Cascade)
  dayOfWeek    Int
  startTime    String
  endTime      String
  isRecurring  Boolean   @default(true)
  specificDate DateTime?
  isAvailable  Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([dayOfWeek])
  @@index([specificDate])
}
