  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([templateId])
  @@index([interviewId])
  @@index([evaluatorId])
  @@index([uid])
  @@index([submittedAt])
  @@index([createdAt])
}

model ScorecardScore {
  id          Int       @id @default(autoincrement())
