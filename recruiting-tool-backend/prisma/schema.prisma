generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id              Int           @id @default(autoincrement())
  uid             String        @unique @default(uuid()) @db.Uuid
  name            String
  description     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  users           User[]
  jobPositions    JobPosition[]
  hiringProcesses HiringProcess[]
}

model User {
  id           Int           @id @default(autoincrement())
  uid          String        @unique @default(uuid()) @db.Uuid
  name         String
  email        String        @unique
  password     String
  roles        RolesType[]   @default([USER])
  profilePicture String?
  phoneNumber  String?
  position     String?
  department   String?
  bio          String?
  linkedinUrl  String?
  timezone     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  companyId    Int?
  company      Company?      @relation(fields: [companyId], references: [id])
  jobPositions JobPosition[] @relation("JobPositionsUser")
  fileUploads  FileUpload[]  @relation("FileUploadsUser")
}

model Candidate {
  id              Int            @id @default(autoincrement())
  uid             String         @unique @default(uuid()) @db.Uuid
  name            String
  email           String
  hiringProcessId Int?           @unique
  hiringProcess   HiringProcess? @relation("HiringProcessCandidate", fields: [hiringProcessId], references: [id])
  files           FileUpload[]   @relation("CandidateFiles")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([hiringProcessId, email])
}

enum RolesType {
  USER
  ADMIN
  SUPER_ADMIN
  HR
}

model JobPosition {
  id              Int               @id @default(autoincrement())
  uid             String            @unique @default(uuid()) @db.Uuid
  title           String
  description     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  createdById     Int
  createdBy       User              @relation("JobPositionsUser", fields: [createdById], references: [id])
  companyId       Int
  company         Company           @relation(fields: [companyId], references: [id])
  stages          Stage[] // Here stages is used to create the template of the job position
  status          JobPositionStatus @default(OPEN)
  hiringProcesses HiringProcess[]
}

model HiringProcess {
  id            Int                 @id @default(autoincrement())
  uid           String              @unique @default(uuid()) @db.Uuid
  title         String
  status        HiringProcessStatus @default(OPEN)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  candidateId   Int?                @unique
  candidate     Candidate?          @relation("HiringProcessCandidate")
  stages        Stage[] // Here stages is used to check on which stage the Candidate is and where
  jobPosition   JobPosition         @relation(fields: [jobPositionId], references: [id])
  jobPositionId Int
  companyId     Int
  company       Company             @relation(fields: [companyId], references: [id])
}

enum HiringProcessStatus {
  OPEN
  CLOSED
  IN_PROGRESS
  CANCELLED
  REJECTED
}

enum JobPositionStatus {
  OPEN
  CLOSED
  CANCELLED
}

model Stage {
  id              Int            @id @default(autoincrement())
  uid             String         @unique @default(uuid()) @db.Uuid
  title           String
  type            StageType
  description     String
  status          StageStatus    @default(OPEN)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  hiringProcess   HiringProcess? @relation(fields: [hiringProcessId], references: [id])
  hiringProcessId Int?
  position        Int
  JobPosition     JobPosition?   @relation(fields: [jobPositionId], references: [id])
  jobPositionId   Int?
  estimatedTime   Int?

  @@unique([hiringProcessId, position])
}

enum StageStatus {
  OPEN
  CURRENT
  CANCELLED
  DONE
}

enum StageType {
  INTERVIEW
  TECHNICAL_INTERVIEW
  FINAL_INTERVIEW
  OFFER
}

model FileUpload {
  id           Int       @id @default(autoincrement())
  uid          String    @unique @default(uuid()) @db.Uuid
  filename     String // Unique filename stored in S3 (with timestamp/uuid)
  originalName String // Original filename from user
  mimetype     String // MIME type (e.g., application/pdf)
  size         Int // File size in bytes
  s3Key        String // S3 object key (path in bucket)
  uploadedById Int
  uploadedBy   User      @relation("FileUploadsUser", fields: [uploadedById], references: [id])
  candidateId  Int?
  candidate    Candidate? @relation("CandidateFiles", fields: [candidateId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
