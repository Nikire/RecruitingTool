model SystemConfig {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@index([key])
}

model PlanLimit {
  id                      Int      @id @default(autoincrement())
  uid                     String   @unique @default(cuid())
  planType                String   // "FREE", "PROFESSIONAL", "ENTERPRISE"
  maxJobPositions         Int      // -1 means unlimited
  maxCandidatesPerPosition Int     // -1 means unlimited
  maxUsers                Int      // -1 means unlimited
  maxStorageMB            Int      // in MB, -1 means unlimited
  aiScoringEnabled        Boolean  @default(false)
  aiScoringCreditsPerMonth Int     // -1 = unlimited, 0 = disabled
  emailTemplatesEnabled   Boolean  @default(true)
  analyticsEnabled        Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([planType])
  @@index([planType])
}

// Feature flags allow admins to toggle features on/off per plan type.
// Each row represents a single feature key + plan type combination.
model FeatureFlag {
  id          Int      @id @default(autoincrement())
  uid         String   @unique @default(cuid())
  key         String   // e.g. "ai_screening", "bulk_import", "advanced_analytics"
  planType    String   // "FREE" | "STARTER" | "PROFESSIONAL" | "ENTERPRISE"
  enabled     Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([key, planType])
  @@index([planType])
  @@index([key])
}
