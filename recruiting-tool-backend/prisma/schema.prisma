generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                 Int                      @id @default(autoincrement())
  uid                String                   @unique @default(uuid()) @db.Uuid
  name               String
  description        String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  logoUrl            String?
  careersEnabled     Boolean                  @default(true)
  careersHeadline    String?
  companySize        String?
  foundedYear        Int?
  industry           String?
  instagramUrl       String?
  linkedinUrl        String?
  location           String?
  timezone           String?
  twitterUrl         String?
  website            String?
  aiQuotas           AIQuota[]
  aiUsageLogs        AIUsageLog[]
  candidates         Candidate[]              @relation("CandidateCompany")
  invitations        CompanyInvitation[]      @relation("CompanyInvitations")
  connectionRequests ConnectionRequest[]
  customPlans        CustomPlan[]             @relation("CompanyCustomPlan")
  emailTemplates     EmailTemplate[]
  feedback           Feedback[]               @relation("CompanyFeedback")
  hiringProcesses    HiringProcess[]
  jobPositions       JobPosition[]
  scorecardTemplates ScorecardTemplate[]
  scoringWeights     CompanyScoringWeights?   @relation("CompanyScoringWeights")
  subscription       Subscription?
  users              User[]
  calendarSettings   CompanyCalendarSettings?

  @@index([uid])
  @@index([name])
}

model CompanyCalendarSettings {
  id                 Int      @id @default(autoincrement())
  uid                String   @unique @default(uuid()) @db.Uuid
  companyId          Int      @unique
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  isBookingEnabled   Boolean  @default(false)
  workingDays        Json     @default("[1,2,3,4,5]")
  workingHoursStart  String   @default("09:00")
  workingHoursEnd    String   @default("18:00")
  bufferMinutes      Int      @default(15)
  blockedDates       Json     @default("[]")
  advanceBookingDays Int      @default(30)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([companyId])
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model User {
  id                         Int                     @id @default(autoincrement())
  uid                        String                  @unique @default(uuid()) @db.Uuid
  name                       String
  email                      String?
  password                   String?
  roles                      RolesType[]             @default([USER])
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  companyId                  Int?
  bio                        String?
  department                 String?
  linkedinUrl                String?
  phoneNumber                String?
  position                   String?
  profilePicture             String?
  timezone                   String?
  googleRefreshToken         String?
  onboardingCompleted        Boolean                 @default(false)
  location                   String?
  portfolioUrl               String?
  resumeFileName             String?
  resumeUrl                  String?
  auth0Id                    String?                 @unique
  provider                   String?                 @default("local")
  emailVerified              Boolean                 @default(false)
  emailVerificationToken     String?                 @unique
  emailVerificationSentAt    DateTime?
  pendingEmail               String?
  emailChangeToken           String?                 @unique
  emailChangeExpiresAt       DateTime?
  isActive                   Boolean                 @default(true)
  deactivatedAt              DateTime?
  lastLoginAt                DateTime?
  aiUsageLogs                AIUsageLog[]            @relation("UserAIUsageLogs")
  reviewedApplications       Application[]           @relation("ApplicationReviewer")
  auditLogs                  AuditLog[]              @relation("UserAuditLogs")
  calendarConnections        CalendarConnection[]    @relation("UserCalendarConnections")
  candidateActivities        CandidateActivity[]     @relation("CandidateActivityUser")
  candidateNotes             CandidateNote[]         @relation("CandidateNoteAuthor")
  sentInvitations            CompanyInvitation[]     @relation("UserInvitations")
  reviewedConnectionRequests ConnectionRequest[]     @relation("ReviewedConnectionRequests")
  connectionRequests         ConnectionRequest[]     @relation("UserConnectionRequests")
  emailTemplates             EmailTemplate[]         @relation("EmailTemplateCreatedBy")
  feedback                   Feedback[]              @relation("UserFeedback")
  fileUploads                FileUpload[]            @relation("FileUploadsUser")
  schedules                  HRSchedule[]            @relation("UserSchedules")
  scheduledInterviews        Interview[]             @relation("InterviewScheduledBy")
  organizedInterviews        Interview[]             @relation("InterviewOrganizer")
  interviewParticipations    InterviewInterviewer[]  @relation("InterviewParticipations")
  interviewReschedules       InterviewReschedule[]   @relation("InterviewReschedules")
  jobPositions               JobPosition[]           @relation("JobPositionsUser")
  notifications              Notification[]          @relation("UserNotifications")
  notificationPreferences    NotificationPreference? @relation("UserNotificationPreferences")
  passwordResetTokens        PasswordResetToken[]    @relation("UserPasswordResetTokens")
  profile                    Profile?
  refreshTokens              RefreshToken[]          @relation("UserRefreshTokens")
  scorecardEvaluations       Scorecard[]             @relation("ScorecardEvaluations")
  stageNotes                 StageNote[]             @relation("StageNoteAuthor")
  createdCandidates          Candidate[]             @relation("CandidateCreatedBy")
  company                    Company?                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  activityLogs               UserActivityLog[]       @relation("UserActivityLogs")

  @@unique([email, companyId])
  @@index([roles])
  @@index([uid])
  @@index([auth0Id])
  @@index([provider])
  @@index([isActive])
  @@index([lastLoginAt])
  @@map("User")
}

model Notification {
  id        Int              @id @default(autoincrement())
  uid       String           @unique @default(uuid()) @db.Uuid
  userId    Int
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())
  readAt    DateTime?
  user      User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([uid])
  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("Notification")
}

model NotificationPreference {
  id                      Int      @id @default(autoincrement())
  uid                     String   @unique @default(uuid()) @db.Uuid
  userId                  Int      @unique
  emailApplicationStatus  Boolean  @default(true)
  emailInterviewScheduled Boolean  @default(true)
  emailNewCandidate       Boolean  @default(true)
  emailSystemAnnouncement Boolean  @default(true)
  inAppApplicationStatus  Boolean  @default(true)
  inAppInterviewScheduled Boolean  @default(true)
  inAppNewCandidate       Boolean  @default(true)
  inAppSystemAnnouncement Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  user                    User     @relation("UserNotificationPreferences", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([uid])
  @@map("NotificationPreference")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Candidate {
  id              Int                 @id @default(autoincrement())
  uid             String              @unique @default(uuid()) @db.Uuid
  name            String
  email           String              @unique
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  source          ApplicationSource?  @default(DIRECT_APPLY)
  sourceDetails   String?
  sourceUrl       String?
  deletedAt       DateTime?
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  companyId       Int?
  createdByUserId Int?
  company         Company?            @relation("CandidateCompany", fields: [companyId], references: [id], onDelete: SetNull)
  createdByUser   User?               @relation("CandidateCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  activities      CandidateActivity[] @relation("CandidateActivities")
  notes           CandidateNote[]     @relation("CandidateNotes")
  scores          CandidateScore[]    @relation("CandidateScores")
  files           FileUpload[]        @relation("CandidateFiles")
  hiringProcesses HiringProcess[]     @relation("HiringProcessCandidate")
  stageTimeLogs   StageTimeLog[]      @relation("CandidateStageTimeLogs")

  @@index([source])
  @@index([companyId])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([uid])
  @@index([createdByUserId])
  @@map("Candidate")
}

model CandidateNote {
  id          Int       @id @default(autoincrement())
  uid         String    @unique @default(uuid()) @db.Uuid
  content     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  candidateId Int
  authorId    Int?
  author      User?     @relation("CandidateNoteAuthor", fields: [authorId], references: [id])
  candidate   Candidate @relation("CandidateNotes", fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([authorId])
  @@index([uid])
}

model JobPosition {
  id                  Int               @id @default(autoincrement())
  uid                 String            @unique @default(uuid()) @db.Uuid
  title               String
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  createdById         Int
  status              JobPositionStatus @default(OPEN)
  companyId           Int
  description         String?
  customQuestions     Json?             @default("[]")
  deletedAt           DateTime?
  applicationDeadline DateTime?
  benefits            String[]          @default([])
  educationLevel      String?
  experienceLevel     ExperienceLevel?
  isFeatured          Boolean           @default(false)
  isUrgent            Boolean           @default(false)
  jobCategory         String?
  jobType             JobType?
  requirements        String[]          @default([])
  responsibilities    String[]          @default([])
  salaryCurrency      String            @default("USD")
  salaryMax           Int?
  salaryMin           Int?
  salaryPeriod        SalaryPeriod?
  skills              String[]          @default([])
  workLocation        WorkLocation?
  applicationCount    Int               @default(0)
  city                String?
  country             String?
  isHighlighted       Boolean           @default(false)
  showSalary          Boolean           @default(false)
  state               String?
  tags                String[]          @default([])
  viewCount           Int               @default(0)
  candidateSource     String?
  applications        Application[]
  batchScoringJobs    BatchScoringJob[] @relation("BatchScoringJobs")
  candidateScores     CandidateScore[]  @relation("JobPositionScores")
  hiringProcesses     HiringProcess[]
  company             Company           @relation(fields: [companyId], references: [id])
  createdBy           User              @relation("JobPositionsUser", fields: [createdById], references: [id])
  stages              Stage[]

  @@index([deletedAt])
  @@index([createdAt])
  @@index([companyId, deletedAt])
  @@index([uid])
  @@index([jobCategory])
  @@index([jobType])
  @@index([workLocation])
  @@index([experienceLevel])
  @@index([isUrgent])
  @@index([isFeatured])
  @@index([applicationDeadline])
  @@index([city])
  @@index([country])
  @@index([isHighlighted])
  @@index([viewCount])
  @@index([applicationCount])
}

model HiringProcess {
  id             Int                 @id @default(autoincrement())
  uid            String              @unique @default(uuid()) @db.Uuid
  title          String
  status         HiringProcessStatus @default(OPEN)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  candidateId    Int?
  jobPositionId  Int
  companyId      Int
  accessCode     String?             @unique
  codeExpiresAt  DateTime?
  lastAccessedAt DateTime?
  accessCount    Int                 @default(0)
  deletedAt      DateTime?
  candidate      Candidate?          @relation("HiringProcessCandidate", fields: [candidateId], references: [id])
  company        Company             @relation(fields: [companyId], references: [id])
  jobPosition    JobPosition         @relation(fields: [jobPositionId], references: [id], onDelete: SetNull)
  stages         Stage[]
  stageNotes     StageNote[]         @relation("HiringProcessStageNotes")

  @@unique([candidateId, jobPositionId])
  @@index([createdAt])
  @@index([uid])
  @@index([accessCode])
  @@index([codeExpiresAt])
  @@index([deletedAt])
}

model Stage {
  id              Int            @id @default(autoincrement())
  uid             String         @unique @default(uuid()) @db.Uuid
  title           String
  type            StageType
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  hiringProcessId Int?
  description     String
  position        Int
  status          StageStatus    @default(OPEN)
  estimatedTime   Int?
  jobPositionId   Int?
  deletedAt       DateTime?
  interviews      Interview[]    @relation("StageInterviews")
  hiringProcess   HiringProcess? @relation(fields: [hiringProcessId], references: [id], onDelete: Cascade)
  JobPosition     JobPosition?   @relation(fields: [jobPositionId], references: [id])
  notes           StageNote[]    @relation("StageNotes")
  timeLogs        StageTimeLog[] @relation("StageTimeLogs")

  @@unique([hiringProcessId, position])
  @@index([deletedAt])
  @@index([uid])
}

model StageNote {
  id              Int           @id @default(autoincrement())
  uid             String        @unique @default(uuid()) @db.Uuid
  content         String
  stageId         Int
  authorId        Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  hiringProcessId Int
  rating          Int
  deletedAt       DateTime?
  author          User          @relation("StageNoteAuthor", fields: [authorId], references: [id])
  hiringProcess   HiringProcess @relation("HiringProcessStageNotes", fields: [hiringProcessId], references: [id], onDelete: Cascade)
  stage           Stage         @relation("StageNotes", fields: [stageId], references: [id], onDelete: Cascade)

  @@unique([stageId, hiringProcessId])
  @@index([stageId])
  @@index([hiringProcessId])
  @@index([authorId])
  @@index([uid])
  @@index([createdAt])
  @@index([deletedAt])
}

model FileUpload {
  id                 Int           @id @default(autoincrement())
  uid                String        @unique @default(uuid()) @db.Uuid
  filename           String
  originalName       String
  mimetype           String
  size               Int
  s3Key              String
  uploadedById       Int?
  candidateId        Int?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  uploadedByPublic   Boolean       @default(false)
  hash               String?
  applicationResumes Application[] @relation("ApplicationResume")
  candidate          Candidate?    @relation("CandidateFiles", fields: [candidateId], references: [id], onDelete: Cascade)
  uploadedBy         User?         @relation("FileUploadsUser", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([uid])
  @@index([uploadedByPublic])
  @@index([hash])
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Application {
  id                Int                @id @default(autoincrement())
  uid               String             @unique @default(uuid()) @db.Uuid
  jobPositionId     Int?
  applicantName     String
  applicantEmail    String
  applicantPhone    String
  resumeFileId      Int?
  coverLetter       String?
  status            ApplicationStatus  @default(PENDING)
  appliedAt         DateTime           @default(now())
  reviewedAt        DateTime?
  reviewedById      Int?
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  customAnswers     Json?              @default("{}")
  deletedAt         DateTime?
  applicationSource ApplicationSource?
  jobPosition       JobPosition?       @relation(fields: [jobPositionId], references: [id])
  resumeFile        FileUpload?        @relation("ApplicationResume", fields: [resumeFileId], references: [id])
  reviewedBy        User?              @relation("ApplicationReviewer", fields: [reviewedById], references: [id])

  @@unique([jobPositionId, applicantEmail])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([uid])
  @@map("Application")
}

model EmailTemplate {
  id          Int                @id @default(autoincrement())
  uid         String             @unique @default(uuid()) @db.Uuid
  name        String
  subject     String
  body        String
  companyId   Int?
  createdById Int
  isDefault   Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  type        EmailTemplateType?
  company     Company?           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy   User               @relation("EmailTemplateCreatedBy", fields: [createdById], references: [id])

  @@unique([name, companyId])
  @@index([companyId])
  @@index([createdById])
  @@index([isDefault])
  @@index([uid])
  @@index([type])
}

model EmailLog {
  id              Int      @id @default(autoincrement())
  uid             String   @unique @default(uuid()) @db.Uuid
  recipientEmail  String
  recipientName   String
  subject         String
  template        String
  status          String   @default("SENT")
  emailType       String
  relatedEntity   String?
  relatedEntityId String?
  sentAt          DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([recipientEmail])
  @@index([sentAt])
  @@index([emailType])
  @@index([relatedEntityId])
  @@index([uid])
}

model Interview {
  id                    Int                     @id @default(autoincrement())
  uid                   String                  @unique @default(uuid()) @db.Uuid
  stageId               Int
  scheduledDate         DateTime?
  scheduledTime         String?
  duration              Int?
  status                InterviewStatus         @default(PENDING)
  meetingLink           String?
  notes                 String?
  scheduledById         Int
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  location              String?
  rescheduledCount      Int                     @default(0)
  originalScheduledDate DateTime?
  lastRescheduledAt     DateTime?
  rescheduledReason     String?
  deletedAt             DateTime?
  calendarEventId       String?
  organizerId           Int?
  scheduledBy           User                    @relation("InterviewScheduledBy", fields: [scheduledById], references: [id])
  organizer             User?                   @relation("InterviewOrganizer", fields: [organizerId], references: [id])
  stage                 Stage                   @relation("StageInterviews", fields: [stageId], references: [id], onDelete: Cascade)
  bookingTokens         InterviewBookingToken[] @relation("InterviewBookingTokens")
  interviewers          InterviewInterviewer[]  @relation("InterviewInterviewers")
  reschedules           InterviewReschedule[]   @relation("InterviewReschedules")
  timeSlots             InterviewTimeSlot[]     @relation("InterviewTimeSlots")
  scorecards            Scorecard[]

  @@index([stageId])
  @@index([scheduledById])
  @@index([organizerId])
  @@index([status])
  @@index([scheduledDate])
  @@index([deletedAt])
  @@index([uid])
}

model InterviewReschedule {
  id               Int       @id @default(autoincrement())
  uid              String    @unique @default(uuid()) @db.Uuid
  interviewId      Int
  oldScheduledDate DateTime
  oldScheduledTime String
  newScheduledDate DateTime
  newScheduledTime String
  reason           String?
  rescheduledById  Int
  rescheduledAt    DateTime  @default(now())
  interview        Interview @relation("InterviewReschedules", fields: [interviewId], references: [id], onDelete: Cascade)
  rescheduledBy    User      @relation("InterviewReschedules", fields: [rescheduledById], references: [id])

  @@index([interviewId])
  @@index([rescheduledById])
  @@index([rescheduledAt])
  @@index([uid])
}

model InterviewTimeSlot {
  id          Int       @id @default(autoincrement())
  uid         String    @unique @default(uuid()) @db.Uuid
  interviewId Int
  startTime   DateTime
  endTime     DateTime
  isAvailable Boolean   @default(true)
  selectedAt  DateTime?
  createdAt   DateTime  @default(now())
  interview   Interview @relation("InterviewTimeSlots", fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId])
  @@index([startTime])
  @@index([isAvailable])
  @@index([uid])
}

model InterviewBookingToken {
  id          Int       @id @default(autoincrement())
  uid         String    @unique @default(uuid()) @db.Uuid
  token       String    @unique
  interviewId Int
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  interview   Interview @relation("InterviewBookingTokens", fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([interviewId])
  @@index([expiresAt])
  @@index([uid])
}

model InterviewInterviewer {
  id          Int       @id @default(autoincrement())
  interviewId Int
  userId      Int
  role        String?
  createdAt   DateTime  @default(now())
  interview   Interview @relation("InterviewInterviewers", fields: [interviewId], references: [id], onDelete: Cascade)
  user        User      @relation("InterviewParticipations", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([interviewId, userId])
  @@index([userId])
  @@index([interviewId])
}

model Profile {
  id          Int      @id @default(autoincrement())
  uid         String   @unique @default(uuid()) @db.Uuid
  bio         String?
  phone       String?
  location    String?
  timezone    String?  @default("UTC")
  preferences Json?    @default("{}")
  userId      Int      @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserActivityLog {
  id        Int      @id @default(autoincrement())
  uid       String   @unique @default(uuid()) @db.Uuid
  userId    Int
  action    String
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation("UserActivityLogs", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([uid])
}

model HRSchedule {
  id           Int       @id @default(autoincrement())
  uid          String    @unique @default(uuid()) @db.Uuid
  userId       Int
  dayOfWeek    Int
  startTime    String
  endTime      String
  isRecurring  Boolean   @default(true)
  specificDate DateTime?
  isAvailable  Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation("UserSchedules", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([dayOfWeek])
  @@index([specificDate])
}

model ScorecardTemplate {
  id          Int                 @id @default(autoincrement())
  uid         String              @unique @default(uuid()) @db.Uuid
  name        String
  description String?
  companyId   Int?
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  submissions Scorecard[]
  categories  ScorecardCategory[]
  company     Company?            @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([isActive])
  @@index([uid])
}

model ScorecardCategory {
  id         Int                  @id @default(autoincrement())
  uid        String               @unique @default(uuid()) @db.Uuid
  templateId Int
  name       String
  weight     Int
  order      Int                  @default(0)
  createdAt  DateTime             @default(now())
  template   ScorecardTemplate    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  criteria   ScorecardCriterion[]

  @@index([templateId])
  @@index([uid])
}

model ScorecardCriterion {
  id          Int               @id @default(autoincrement())
  uid         String            @unique @default(uuid()) @db.Uuid
  categoryId  Int
  name        String
  description String?
  maxScore    Int               @default(5)
  order       Int               @default(0)
  createdAt   DateTime          @default(now())
  category    ScorecardCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([uid])
}

model Scorecard {
  id           Int               @id @default(autoincrement())
  uid          String            @unique @default(uuid()) @db.Uuid
  templateId   Int
  interviewId  Int?
  evaluatorId  Int
  overallScore Float?
  notes        String?
  submittedAt  DateTime          @default(now())
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  evaluator    User              @relation("ScorecardEvaluations", fields: [evaluatorId], references: [id])
  interview    Interview?        @relation(fields: [interviewId], references: [id])
  template     ScorecardTemplate @relation(fields: [templateId], references: [id])
  scores       ScorecardScore[]

  @@index([templateId])
  @@index([interviewId])
  @@index([evaluatorId])
  @@index([uid])
}

model ScorecardScore {
  id          Int       @id @default(autoincrement())
  scorecardId Int
  criterionId Int
  score       Int
  notes       String?
  createdAt   DateTime  @default(now())
  scorecard   Scorecard @relation(fields: [scorecardId], references: [id], onDelete: Cascade)

  @@unique([scorecardId, criterionId])
  @@index([scorecardId])
}

model AIQuota {
  id        Int       @id @default(autoincrement())
  uid       String    @unique @default(uuid()) @db.Uuid
  companyId Int
  quotaType QuotaType
  limit     Int
  used      Int       @default(0)
  resetDate DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, quotaType])
  @@index([companyId])
  @@index([quotaType])
  @@index([uid])
}

model AIUsageLog {
  id         Int       @id @default(autoincrement())
  uid        String    @unique @default(uuid()) @db.Uuid
  companyId  Int
  userId     Int
  operation  QuotaType
  tokensUsed Int?
  cost       Float?
  createdAt  DateTime  @default(now())
