POSTGRES_USER = postgres
POSTGRES_PASSWORD = postgrespassword

API_PORT = 4000
VITE_PORT = 3000

PGADMIN_EMAIL = admin@local.test
PGADMIN_PASSWORD = admin1234

# MinIO Configuration (S3-compatible local file storage)
MINIO_ROOT_USER = minioadmin
MINIO_ROOT_PASSWORD = minioadmin

# n8n Workflow Automation
N8N_USER=admin
N8N_PASSWORD=admin123
N8N_HOST=localhost

# Webhook API Key for n8n Integration
WEBHOOK_API_KEY=your-secure-webhook-api-key-change-in-production

# Stripe Configuration
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here
# Get this from https://dashboard.stripe.com/webhooks (use stripe-cli for local dev)
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret-here
# Get price IDs from https://dashboard.stripe.com/products
STRIPE_PROFESSIONAL_PRICE_ID=price_professional_monthly_id
STRIPE_PROFESSIONAL_ANNUAL_PRICE_ID=price_professional_annual_id
STRIPE_ENTERPRISE_PRICE_ID=price_enterprise_monthly_id
STRIPE_ENTERPRISE_ANNUAL_PRICE_ID=price_enterprise_annual_id

# SMTP / Email Configuration
# Recommended: Resend (https://resend.com) - free tier: 3,000 emails/month
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=re_your-resend-api-key-here
SMTP_FROM=noreply@yourdomain.com