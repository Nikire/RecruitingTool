        "jsonBody": "={\n  \"batchName\": \"Apollo Auto-Import — {{ new Date().toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) }}\",\n  \"issues\": [],\n  \"testingChecklist\": [\n    \"Check /admin/outreach-campaigns for new leads\",\n    \"Verify lead count matches Apollo results\",\n    \"Review notes field contains title/industry/location\"\n  ],\n  \"additionalNotes\": \"Apollo auto-import ran. Fetched {{ $('Transform to Leads').first().json.totalFetched }} people, imported {{ $('Import to Borderless').first().json.imported }} leads, skipped {{ $('Import to Borderless').first().json.skipped }}.\"\n}",
        "options": {}
