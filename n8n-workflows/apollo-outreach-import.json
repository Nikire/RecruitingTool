    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apollo.io/v1/mixed_people/search",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Api-Key",
              "value": "={{ $json.apolloApiKey }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"q_organization_num_employees_ranges\": [\"50,500\"],\n  \"person_titles\": [\n    \"HR Director\",\n    \"VP of People\",\n    \"Head of Talent Acquisition\",\n    \"Talent Acquisition Manager\",\n    \"HR Manager\",\n    \"People Operations Manager\",\n    \"Head of HR\"\n  ],\n  \"contact_email_status\": [\"verified\", \"likely to engage\"],\n  \"page\": 1,\n  \"per_page\": 25\n}",
        "options": {}
      },
      "id": "aaaaaaaa-0003-0003-0003-000000000003",
      "name": "Apollo Search (Page 1)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 360]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Get config from the Config node\nconst config = $('⚙️ Config (edit me)').first().json;\n\n// Get people from Apollo response\nconst people = $input.first().json.people || [];\n\n// Transform Apollo fields to Borderless lead format\nconst leads = people\n  .map(p => {\n    const firstName = (p.first_name || '').trim();\n    const lastName = (p.last_name || '').trim();\n    const name = [firstName, lastName].filter(Boolean).join(' ');\n    const company = (p.organization && p.organization.name) || '';\n\n    if (!name && !company) return null;\n\n    const noteParts = [\n      p.title || null,\n      (p.organization && p.organization.industry) || null,\n      (p.organization && p.organization.estimated_num_employees)\n        ? `${p.organization.estimated_num_employees} employees`\n        : null,\n      p.country || null\n    ].filter(Boolean);\n\n    return {\n      name: name || company,\n      company: company || name,\n      email: p.email || null,\n      linkedinUrl: p.linkedin_url || null,\n      notes: noteParts.length > 0 ? noteParts.join(' | ') : null\n    };\n  })\n  .filter(Boolean);\n\nreturn [{\n  json: {\n    leads,\n    campaignUid: config.campaignUid,\n    webhookApiKey: config.webhookApiKey,\n    apiBaseUrl: config.apiBaseUrl,\n    totalFetched: people.length,\n    totalToImport: leads.length\n  }\n}];"
      },
      "id": "aaaaaaaa-0004-0004-0004-000000000004",
      "name": "Transform to Leads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [920, 360]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.apiBaseUrl + '/outreach-campaigns/' + $json.campaignUid + '/leads/bulk' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $json.webhookApiKey }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ leads: $json.leads }) }}",
        "options": {}
      },
      "id": "aaaaaaaa-0005-0005-0005-000000000005",
      "name": "Import to Borderless",
