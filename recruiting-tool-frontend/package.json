{
	"name": "recruiting-tool-frontend",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"build:vite": "vite build",
		"lint": "eslint .",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write \"src/**/*.{ts,tsx}\"",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"docker:build": "docker-compose up -d --build frontend",
		"docker:rebuild": "docker-compose up -d --build",
		"docker:logs": "docker-compose logs frontend --tail 100",
		"docker:logs:follow": "docker-compose logs frontend --follow",
		"docker:restart": "docker-compose restart frontend",
		"checks": "npm run typecheck && npm run lint",
		"checks:fix": "npm run format && npm run lint",
		"agent:log": "node -e \"const fs=require('fs');const msg=process.argv[1];const date=new Date().toISOString().slice(0,19).replace('T',' ');fs.appendFileSync('../.claude/logs/agent-activity.log','['+date+'] [npm-script] '+msg+'\\n---\\n');\""
	},
	"dependencies": {
		"@auth0/auth0-react": "^2.10.0",
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.0",
		"@fontsource/roboto": "^5.1.1",
		"@mui/icons-material": "^7.3.4",
		"@mui/lab": "^7.0.0-beta.11",
		"@mui/material": "^7.0.2",
		"@mui/styled-engine-sc": "^6.4.3",
		"@mui/system": "^7.3.5",
		"@mui/x-data-grid": "^8.20.0",
		"@mui/x-date-pickers": "^8.18.0",
		"@tanstack/react-query": "^5.74.4",
		"axios": "^1.8.4",
		"date-fns": "^4.1.0",
		"flag-icons": "^7.5.0",
		"i18next": "^25.6.3",
		"i18next-browser-languagedetector": "^8.2.0",
		"jotai": "^2.15.1",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-hook-form": "^7.56.4",
		"react-hot-toast": "^2.6.0",
		"react-i18next": "^16.3.5",
		"react-is": "^19.2.0",
		"react-router": "^7.5.1",
		"react-router-dom": "^7.5.1",
		"recharts": "^3.5.0",
		"styled-components": "^6.1.15"
	},
	"devDependencies": {
		"@eslint/js": "^9.19.0",
		"@testing-library/dom": "10.4.0",
		"@testing-library/jest-dom": "6.6.3",
		"@testing-library/react": "16.0.1",
		"@testing-library/user-event": "14.5.2",
		"@types/node": "^22.14.1",
		"@types/react": "^19.1.2",
		"@types/react-dom": "^19.1.2",
		"@types/react-router-dom": "^5.3.3",
		"@vitejs/plugin-react": "^4.4.1",
		"@vitejs/plugin-react-swc": "^3.5.0",
		"esbuild": "0.25.4",
		"eslint": "^9.19.0",
		"eslint-plugin-react-hooks": "^5.0.0",
		"eslint-plugin-react-refresh": "^0.4.18",
		"globals": "^15.14.0",
		"jsdom": "25.0.1",
		"msw": "^2.12.4",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.22.0",
		"vite": "^6.3.2",
		"vitest": "2.1.8"
	}
}
