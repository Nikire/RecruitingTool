VITE_API_URL='http://localhost:4000' # Or 'http://backend:4000' for docker
VITE_PORT=3000 # Frontend port

# Auth0 Configuration (Optional - for social login)
# Leave empty to disable social login buttons
# VITE_AUTH0_DOMAIN='your-tenant.auth0.com'
# VITE_AUTH0_CLIENT_ID='your-client-id'
# VITE_AUTH0_AUDIENCE='your-api-audience'

# --- Product Analytics: PostHog (Optional) ---
# Leave unset to disable analytics entirely. With no key the app makes ZERO
# network calls to PostHog and every track()/identify() call is a silent no-op.
# Key is the PUBLIC project API key from PostHog > Settings > Project.
# VITE_POSTHOG_KEY='phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx'
# Ingestion host. EU projects MUST use https://eu.i.posthog.com.
# Defaults to the US cloud host when unset.
# VITE_POSTHOG_HOST='https://us.i.posthog.com'

# --- Error Monitoring: Sentry (Optional) ---
# Leave unset to disable error reporting. Without a DSN the Sentry SDK is never
# initialised and failed API calls are only logged to the dev console.
# VITE_SENTRY_DSN='https://<publicKey>@o0.ingest.sentry.io/0'
# Environment tag on every event. Defaults to the Vite mode when unset.
# VITE_SENTRY_ENVIRONMENT='production'
# Performance tracing sample rate, 0..1. Defaults to 0 (tracing off) because
# tracing multiplies event volume and burns the free-tier quota.
# VITE_SENTRY_TRACES_SAMPLE_RATE='0'
# Release identifier, used to group events and map stack traces to a build.
# VITE_APP_VERSION='1.0.0'

# NOTE: every VITE_* value is inlined by Vite at BUILD time. In Docker they must
# be passed as build args (see docker-compose.yml -> services.frontend.build.args
# and .github/workflows/deploy-prod.yml); setting them on a running container
# has no effect.
